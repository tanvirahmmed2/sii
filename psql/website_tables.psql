-- ============================================================================
-- TENANT WEBSITES SUBSCHEMA (STAFF & MODULE SUBSETS ONLY)
-- Isolated Schema Definition for Tenant Educational Websites
-- Scoped by website_id & prefixed with website_
-- All other website modules will be created incrementally as needed.
-- ============================================================================

-- Enable required extensions
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- ============================================================================
-- GLOBAL UTILITY FUNCTIONS & TRIGGERS
-- ============================================================================

CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;


-- ============================================================================
-- SECTION 1: MODULE TABLES
-- ============================================================================

-- ----------------------------------------------------------------------------
-- 1. WEBSITE MODULES TABLE (Tenant Features / School System Modules Catalog)
-- e.g., Attendance, Exams, LMS, Hostel, Fees, Accounting, Inventory
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_modules (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(100) UNIQUE NOT NULL,
    slug VARCHAR(100) UNIQUE NOT NULL,
    description TEXT,
    icon VARCHAR(100),
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_modules_updated_at ON website_modules;
CREATE TRIGGER update_website_modules_updated_at
    BEFORE UPDATE ON website_modules
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();


-- ============================================================================
-- SECTION 2: STAFF TABLES
-- ============================================================================

-- ----------------------------------------------------------------------------
-- 2. WEBSITE STAFF PAY SCALE TABLE (Staff Salary Grade / Scale)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_staff_pay_scale (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    basic_salary NUMERIC(12, 2) NOT NULL DEFAULT 0.00 CHECK (basic_salary >= 0.00),
    allowance NUMERIC(12, 2) NOT NULL DEFAULT 0.00 CHECK (allowance >= 0.00),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, name)
);

DROP TRIGGER IF EXISTS update_website_staff_pay_scale_updated_at ON website_staff_pay_scale;
CREATE TRIGGER update_website_staff_pay_scale_updated_at
    BEFORE UPDATE ON website_staff_pay_scale
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 3. WEBSITE STAFFS TABLE (Admins, Registrars, Cashiers, General Staff)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_staffs (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL,
    number VARCHAR(50) NOT NULL,
    address TEXT,
    password VARCHAR(255) NOT NULL,
    recovery_token VARCHAR(255),
    recovery_token_expires TIMESTAMPTZ,
    two_factor_code VARCHAR(10),
    two_factor_expires TIMESTAMPTZ,
    is_active BOOLEAN DEFAULT TRUE,
    is_registered BOOLEAN DEFAULT TRUE,
    is_two_factor_enabled BOOLEAN DEFAULT FALSE,
    verification_token VARCHAR(255),
    verification_token_expires TIMESTAMPTZ,
    grade_id BIGINT REFERENCES website_staff_pay_scale(id) ON DELETE SET NULL,
    image TEXT,
    image_id VARCHAR(255),
    date_of_birth DATE,
    nationality VARCHAR(100),
    blood_group VARCHAR(10),
    gender VARCHAR(20),
    nid_number VARCHAR(100),
    bio TEXT,
    username VARCHAR(255),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, email),
    UNIQUE(website_id, username)
);

DROP TRIGGER IF EXISTS update_website_staffs_updated_at ON website_staffs;
CREATE TRIGGER update_website_staffs_updated_at
    BEFORE UPDATE ON website_staffs
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 4. WEBSITE STAFF EXPERIENCES TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_staff_experiences (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    staff_id BIGINT NOT NULL REFERENCES website_staffs(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    organization VARCHAR(255) NOT NULL,
    start_date DATE,
    end_date DATE,
    is_current BOOLEAN DEFAULT FALSE,
    description TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_staff_experiences_updated_at ON website_staff_experiences;
CREATE TRIGGER update_website_staff_experiences_updated_at
    BEFORE UPDATE ON website_staff_experiences
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 5. WEBSITE MODULES PERMISSIONS TABLE (Granular Module Access for Tenant Staff)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_modules_permissions (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    staff_id BIGINT NOT NULL REFERENCES website_staffs(id) ON DELETE CASCADE,
    website_module_id BIGINT NOT NULL REFERENCES website_modules(id) ON DELETE CASCADE,
    can_view BOOLEAN DEFAULT TRUE,
    can_create BOOLEAN DEFAULT FALSE,
    can_edit BOOLEAN DEFAULT FALSE,
    can_delete BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(staff_id, website_module_id)
);

CREATE INDEX IF NOT EXISTS idx_website_modules_permissions_staff_id ON website_modules_permissions(staff_id);
CREATE INDEX IF NOT EXISTS idx_website_modules_permissions_website_id ON website_modules_permissions(website_id);
CREATE INDEX IF NOT EXISTS idx_website_modules_permissions_module_id ON website_modules_permissions(website_module_id);

DROP TRIGGER IF EXISTS update_website_modules_permissions_updated_at ON website_modules_permissions;
CREATE TRIGGER update_website_modules_permissions_updated_at
    BEFORE UPDATE ON website_modules_permissions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 6. STAFF SESSIONS TABLE (Active Multi-Device Sessions for Tenant Staff)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS staff_sessions (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    staff_id BIGINT NOT NULL REFERENCES website_staffs(id) ON DELETE CASCADE,
    token TEXT UNIQUE NOT NULL,
    ip_address VARCHAR(45),
    user_agent TEXT,
    device_info TEXT,
    is_active BOOLEAN DEFAULT TRUE,
    expires_at TIMESTAMPTZ NOT NULL,
    last_active_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_staff_sessions_staff_id ON staff_sessions(staff_id);
CREATE INDEX IF NOT EXISTS idx_staff_sessions_website_id ON staff_sessions(website_id);
CREATE INDEX IF NOT EXISTS idx_staff_sessions_token ON staff_sessions(token);

DROP TRIGGER IF EXISTS update_staff_sessions_updated_at ON staff_sessions;
CREATE TRIGGER update_staff_sessions_updated_at
    BEFORE UPDATE ON staff_sessions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 7. WEBSITE STAFF SALARIES TABLE (Staff Payroll Ledger)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_staff_salaries (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    staff_id BIGINT REFERENCES website_staffs(id) ON DELETE CASCADE,
    month VARCHAR(50) NOT NULL,
    basic DECIMAL(10, 2) NOT NULL DEFAULT 0.00 CHECK (basic >= 0.00),
    allowance DECIMAL(10, 2) NOT NULL DEFAULT 0.00 CHECK (allowance >= 0.00),
    deductions DECIMAL(10, 2) NOT NULL DEFAULT 0.00 CHECK (deductions >= 0.00),
    status VARCHAR(50) NOT NULL DEFAULT 'Pending',
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_staff_salaries_updated_at ON website_staff_salaries;
CREATE TRIGGER update_website_staff_salaries_updated_at
    BEFORE UPDATE ON website_staff_salaries
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 8. WEBSITE STAFF SALARY PAYMENTS TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_staff_salary_payments (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    staff_salary_id BIGINT NOT NULL REFERENCES website_staff_salaries(id) ON DELETE CASCADE,
    amount_paid DECIMAL(10, 2) NOT NULL DEFAULT 0.00 CHECK (amount_paid >= 0.00),
    payment_method VARCHAR(50) NOT NULL DEFAULT 'Bank Transfer',
    transaction_id VARCHAR(100),
    remarks TEXT,
    payment_date TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_staff_salary_payments_updated_at ON website_staff_salary_payments;
CREATE TRIGGER update_website_staff_salary_payments_updated_at
    BEFORE UPDATE ON website_staff_salary_payments
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 9. WEBSITE STAFF ATTENDANCE TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_staff_attendance (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    staff_id BIGINT NOT NULL REFERENCES website_staffs(id) ON DELETE CASCADE,
    date DATE NOT NULL DEFAULT CURRENT_DATE,
    check_in VARCHAR(50),
    check_out VARCHAR(50),
    status VARCHAR(50) NOT NULL DEFAULT 'Present',
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, staff_id, date)
);

DROP TRIGGER IF EXISTS update_website_staff_attendance_updated_at ON website_staff_attendance;
CREATE TRIGGER update_website_staff_attendance_updated_at
    BEFORE UPDATE ON website_staff_attendance
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 10. WEBSITE STAFF LEAVES TABLE (Leave Applications)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_staff_leaves (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    staff_id BIGINT NOT NULL REFERENCES website_staffs(id) ON DELETE CASCADE,
    type VARCHAR(100) NOT NULL,
    start_date DATE NOT NULL,
    end_date DATE NOT NULL,
    reason TEXT NOT NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'Pending',
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_staff_leaves_updated_at ON website_staff_leaves;
CREATE TRIGGER update_website_staff_leaves_updated_at
    BEFORE UPDATE ON website_staff_leaves
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 11. WEBSITE STAFF APPLICATIONS TABLE (Internal Staff Requests)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_staff_applications (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    staff_id BIGINT REFERENCES website_staffs(id) ON DELETE CASCADE,
    type VARCHAR(100) NOT NULL,
    title VARCHAR(255) NOT NULL,
    details TEXT NOT NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'Pending',
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_staff_applications_updated_at ON website_staff_applications;
CREATE TRIGGER update_website_staff_applications_updated_at
    BEFORE UPDATE ON website_staff_applications
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();


-- ============================================================================
-- SECTION 3: ACADEMIC & CLASS ROUTINE TABLES
-- ============================================================================

-- ----------------------------------------------------------------------------
-- 12. WEBSITE SESSIONS TABLE (Academic Sessions e.g., 2021-2022, 2025-2026)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_sessions (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    start_date DATE,
    end_date DATE,
    is_current BOOLEAN DEFAULT FALSE,
    status VARCHAR(50) DEFAULT 'active' CHECK (status IN ('active', 'inactive', 'archived', 'upcoming')),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, name)
);

DROP TRIGGER IF EXISTS update_website_sessions_updated_at ON website_sessions;
CREATE TRIGGER update_website_sessions_updated_at
    BEFORE UPDATE ON website_sessions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 13. WEBSITE CLASSES TABLE (Grades / Classes in the School)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_classes (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    numeric_name INT NOT NULL,
    code VARCHAR(50) NOT NULL,
    max_seats INT DEFAULT 40,
    description TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, name),
    UNIQUE(website_id, code)
);

DROP TRIGGER IF EXISTS update_website_classes_updated_at ON website_classes;
CREATE TRIGGER update_website_classes_updated_at
    BEFORE UPDATE ON website_classes
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 14. WEBSITE SECTIONS TABLE (Class Sections / Batches)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_sections (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    class_id BIGINT NOT NULL REFERENCES website_classes(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    capacity INT DEFAULT 40,
    room_number VARCHAR(50),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, class_id, name)
);

DROP TRIGGER IF EXISTS update_website_sections_updated_at ON website_sections;
CREATE TRIGGER update_website_sections_updated_at
    BEFORE UPDATE ON website_sections
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 15. WEBSITE SUBJECTS TABLE (Courses / Subjects Taught)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_subjects (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    code VARCHAR(50) NOT NULL,
    type VARCHAR(50) DEFAULT 'Theory' CHECK (type IN ('Theory', 'Practical', 'Both', 'Optional')),
    description TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, name),
    UNIQUE(website_id, code)
);

DROP TRIGGER IF EXISTS update_website_subjects_updated_at ON website_subjects;
CREATE TRIGGER update_website_subjects_updated_at
    BEFORE UPDATE ON website_subjects
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 16. WEBSITE CLASS SUBJECTS TABLE (Subject Mapping to Classes)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_class_subjects (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    class_id BIGINT NOT NULL REFERENCES website_classes(id) ON DELETE CASCADE,
    subject_id BIGINT NOT NULL REFERENCES website_subjects(id) ON DELETE CASCADE,
    full_marks NUMERIC(6, 2) DEFAULT 100.00 CHECK (full_marks >= 0.00),
    pass_marks NUMERIC(6, 2) DEFAULT 33.00 CHECK (pass_marks >= 0.00),
    is_optional BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, class_id, subject_id)
);

DROP TRIGGER IF EXISTS update_website_class_subjects_updated_at ON website_class_subjects;
CREATE TRIGGER update_website_class_subjects_updated_at
    BEFORE UPDATE ON website_class_subjects
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 17. WEBSITE DAYS TABLE (Academic Schedule Days)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_days (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(50) NOT NULL,
    day_order INT NOT NULL DEFAULT 1 CHECK (day_order BETWEEN 1 AND 7),
    status VARCHAR(10) CHECK(status IN ('on', 'off')) DEFAULT 'on',
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, name)
);

DROP TRIGGER IF EXISTS update_website_days_updated_at ON website_days;
CREATE TRIGGER update_website_days_updated_at
    BEFORE UPDATE ON website_days
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 18. WEBSITE PERIODS TABLE (Class Time Slots Linked with Day)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_periods (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    day_id BIGINT NOT NULL REFERENCES website_days(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    start_time VARCHAR(50) NOT NULL,
    end_time VARCHAR(50) NOT NULL,
    is_break BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, day_id, name)
);

DROP TRIGGER IF EXISTS update_website_periods_updated_at ON website_periods;
CREATE TRIGGER update_website_periods_updated_at
    BEFORE UPDATE ON website_periods
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 19. WEBSITE PERIOD CLASS SUBJECTS TABLE (Links Class Subject with Period & Section)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_period_class_subjects (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    period_id BIGINT NOT NULL REFERENCES website_periods(id) ON DELETE CASCADE,
    class_subject_id BIGINT NOT NULL REFERENCES website_class_subjects(id) ON DELETE CASCADE,
    section_id BIGINT REFERENCES website_sections(id) ON DELETE CASCADE,
    session_id BIGINT REFERENCES website_sessions(id) ON DELETE SET NULL,
    room_number VARCHAR(50),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX IF NOT EXISTS website_pcs_unique_idx
  ON website_period_class_subjects (website_id, period_id, class_subject_id, COALESCE(section_id, -1));

DROP TRIGGER IF EXISTS update_website_period_class_subjects_updated_at ON website_period_class_subjects;
CREATE TRIGGER update_website_period_class_subjects_updated_at
    BEFORE UPDATE ON website_period_class_subjects
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();


-- ----------------------------------------------------------------------------
-- 20. WEBSITE BREVO MAILER TABLE (Transactional Email Credentials)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_brevo_mailer (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    brevo_api_key TEXT NOT NULL,
    brevo_sender_email VARCHAR(255) NOT NULL,
    brevo_sender_name VARCHAR(255) NOT NULL,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id)
);

DROP TRIGGER IF EXISTS update_website_brevo_mailer_updated_at ON website_brevo_mailer;
CREATE TRIGGER update_website_brevo_mailer_updated_at
    BEFORE UPDATE ON website_brevo_mailer
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 21. WEBSITE META TABLE (Facebook, Instagram & WhatsApp Integration Keys)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_meta (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    -- Meta Message Receiver (Inbound Webhooks)
    meta_webhook_verify_token VARCHAR(255),
    meta_app_secret TEXT,
    meta_app_id VARCHAR(255),
    -- Meta Message Reply / Outbound (Optional)
    meta_page_access_token TEXT,
    whatsapp_phone_number_id VARCHAR(255),
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id)
);

DROP TRIGGER IF EXISTS update_website_meta_updated_at ON website_meta;
CREATE TRIGGER update_website_meta_updated_at
    BEFORE UPDATE ON website_meta
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 22. WEBSITE META CONVERSATIONS TABLE (Facebook, Instagram & WhatsApp Threads)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_meta_conversations (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    platform VARCHAR(50) NOT NULL CHECK (platform IN ('facebook', 'instagram', 'whatsapp')),
    external_conversation_id VARCHAR(255) NOT NULL,
    recipient_id VARCHAR(255) NOT NULL,
    recipient_name VARCHAR(255) DEFAULT 'Customer',
    recipient_phone VARCHAR(50),
    recipient_avatar TEXT,
    last_message TEXT,
    last_message_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    status VARCHAR(50) NOT NULL DEFAULT 'OPEN' CHECK (status IN ('OPEN', 'RESOLVED', 'SPAM')),
    unread_count INT NOT NULL DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, platform, external_conversation_id)
);

DROP TRIGGER IF EXISTS update_website_meta_conv_updated_at ON website_meta_conversations;
CREATE TRIGGER update_website_meta_conv_updated_at
    BEFORE UPDATE ON website_meta_conversations
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 23. WEBSITE META MESSAGES TABLE (Facebook, Instagram & WhatsApp Chat Messages)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_meta_messages (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    conversation_id BIGINT NOT NULL REFERENCES website_meta_conversations(id) ON DELETE CASCADE,
    platform VARCHAR(50) NOT NULL CHECK (platform IN ('facebook', 'instagram', 'whatsapp')),
    sender_type VARCHAR(50) NOT NULL CHECK (sender_type IN ('CUSTOMER', 'STAFF', 'SYSTEM', 'customer', 'staff', 'system')),
    sender_id VARCHAR(255),
    sender_name VARCHAR(255),
    message_text TEXT NOT NULL,
    media_url TEXT,
    media_type VARCHAR(50),
    external_message_id VARCHAR(255),
    delivery_status VARCHAR(50) DEFAULT 'SENT' CHECK (delivery_status IN ('SENDING', 'SENT', 'DELIVERED', 'READ', 'FAILED', 'sending', 'sent', 'delivered', 'read', 'failed')),
    error_message TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);


-- ----------------------------------------------------------------------------
-- 24. WEBSITE NOTICES TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_notices (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    slug VARCHAR(255) NOT NULL,
    drive_url TEXT NOT NULL,
    description TEXT,
    published_date DATE DEFAULT CURRENT_DATE,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, slug)
);

DROP TRIGGER IF EXISTS update_website_notices_updated_at ON website_notices;
CREATE TRIGGER update_website_notices_updated_at
    BEFORE UPDATE ON website_notices
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 25. WEBSITE AWARDS TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_awards (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    slug VARCHAR(255) NOT NULL,
    description TEXT,
    year INT,
    issuer VARCHAR(255),
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, slug)
);

DROP TRIGGER IF EXISTS update_website_awards_updated_at ON website_awards;
CREATE TRIGGER update_website_awards_updated_at
    BEFORE UPDATE ON website_awards
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 26. WEBSITE AWARD IMAGES TABLE (Strictly Single Image per Award)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_award_images (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    award_id BIGINT NOT NULL REFERENCES website_awards(id) ON DELETE CASCADE,
    image_url TEXT NOT NULL,
    image_id VARCHAR(255),
    caption TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(award_id)
);

DROP TRIGGER IF EXISTS update_website_award_images_updated_at ON website_award_images;
CREATE TRIGGER update_website_award_images_updated_at
    BEFORE UPDATE ON website_award_images
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 27. WEBSITE NEWS TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_news (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    slug VARCHAR(255) NOT NULL,
    summary TEXT,
    content TEXT,
    category VARCHAR(100) DEFAULT 'General',
    published_date DATE DEFAULT CURRENT_DATE,
    is_published BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, slug)
);

DROP TRIGGER IF EXISTS update_website_news_updated_at ON website_news;
CREATE TRIGGER update_website_news_updated_at
    BEFORE UPDATE ON website_news
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 28. WEBSITE NEWS IMAGES TABLE (Multiple Images per News Article)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_news_images (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    news_id BIGINT NOT NULL REFERENCES website_news(id) ON DELETE CASCADE,
    image_url TEXT NOT NULL,
    image_id VARCHAR(255),
    caption TEXT,
    is_cover BOOLEAN DEFAULT FALSE,
    display_order INT DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_news_images_updated_at ON website_news_images;
CREATE TRIGGER update_website_news_images_updated_at
    BEFORE UPDATE ON website_news_images
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();


-- ============================================================================
-- SECTION 4: PERFORMANCE INDEXES
-- ============================================================================

-- Staff Indexes
CREATE INDEX IF NOT EXISTS idx_ws_staffs_website ON website_staffs(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_staff_salaries_website ON website_staff_salaries(website_id, staff_id);
CREATE INDEX IF NOT EXISTS idx_ws_staff_attendance_lookup ON website_staff_attendance(website_id, staff_id, date);
CREATE INDEX IF NOT EXISTS idx_ws_staff_leaves_lookup ON website_staff_leaves(website_id, staff_id, status);
CREATE INDEX IF NOT EXISTS idx_ws_staff_applications_lookup ON website_staff_applications(website_id, staff_id, status);

-- Academic & Class Routine Indexes
CREATE INDEX IF NOT EXISTS idx_ws_sessions_website ON website_sessions(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_classes_website ON website_classes(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_sections_class ON website_sections(website_id, class_id);
CREATE INDEX IF NOT EXISTS idx_ws_subjects_website ON website_subjects(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_class_subjects_class ON website_class_subjects(website_id, class_id);
CREATE INDEX IF NOT EXISTS idx_ws_class_subjects_subject ON website_class_subjects(website_id, subject_id);
CREATE INDEX IF NOT EXISTS idx_ws_days_website ON website_days(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_periods_day ON website_periods(website_id, day_id);
CREATE INDEX IF NOT EXISTS idx_ws_pcs_period ON website_period_class_subjects(website_id, period_id);
CREATE INDEX IF NOT EXISTS idx_ws_pcs_class_subject ON website_period_class_subjects(website_id, class_subject_id);

-- Mailer, Meta & Messaging Indexes
CREATE INDEX IF NOT EXISTS idx_ws_brevo_mailer_website ON website_brevo_mailer(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_meta_website ON website_meta(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_meta_conv_website ON website_meta_conversations(website_id, platform);
CREATE INDEX IF NOT EXISTS idx_ws_meta_conv_lookup ON website_meta_conversations(website_id, platform, status);
CREATE INDEX IF NOT EXISTS idx_ws_meta_msg_conv ON website_meta_messages(conversation_id);
CREATE INDEX IF NOT EXISTS idx_ws_meta_msg_created ON website_meta_messages(created_at ASC);

-- Notices, Awards & News Indexes
CREATE INDEX IF NOT EXISTS idx_ws_notices_website ON website_notices(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_notices_active ON website_notices(website_id, is_active, published_date DESC);
CREATE INDEX IF NOT EXISTS idx_ws_awards_website ON website_awards(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_award_images_award ON website_award_images(award_id);
CREATE INDEX IF NOT EXISTS idx_ws_news_website ON website_news(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_news_published ON website_news(website_id, is_published, published_date DESC);
CREATE INDEX IF NOT EXISTS idx_ws_news_images_news ON website_news_images(news_id, display_order ASC);


