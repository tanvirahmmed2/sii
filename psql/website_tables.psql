    BEFORE UPDATE ON website_hostel_applications
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 113. WEBSITE HOSTEL FEES TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_hostel_fees (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    student_id BIGINT NOT NULL REFERENCES website_students(id) ON DELETE CASCADE,
    amount DECIMAL(10, 2) NOT NULL DEFAULT 0.00 CHECK (amount >= 0.00),
    due_date DATE NOT NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'Unpaid' CHECK (status IN ('Paid', 'Unpaid', 'Partially Paid')),
    paid_amount DECIMAL(10, 2) NOT NULL DEFAULT 0.00 CHECK (paid_amount >= 0.00),
    payment_date TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_hostel_fees_updated_at ON website_hostel_fees;
CREATE TRIGGER update_website_hostel_fees_updated_at
    BEFORE UPDATE ON website_hostel_fees
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 114. WEBSITE PAYMENT TRANSACTIONS TABLE (Institutional Accounts Ledger)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_payment_transactions (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    transaction_number VARCHAR(100) NOT NULL,
    payment_method VARCHAR(50) NOT NULL DEFAULT 'Cash',
    amount DECIMAL(12, 2) NOT NULL CHECK (amount >= 0.00),
    transaction_type VARCHAR(50) NOT NULL CHECK (transaction_type IN ('Credit', 'Debit')),
    category VARCHAR(100) NOT NULL,
    reference_id BIGINT,
    payment_gateway VARCHAR(100),
    gateway_transaction_id VARCHAR(100),
    status VARCHAR(50) NOT NULL DEFAULT 'Success' CHECK (status IN ('Pending', 'Success', 'Failed')),
    remarks TEXT,
    billed_by VARCHAR(255),
    payment_date TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, transaction_number)
);

DROP TRIGGER IF EXISTS update_website_payment_transactions_updated_at ON website_payment_transactions;
CREATE TRIGGER update_website_payment_transactions_updated_at
    BEFORE UPDATE ON website_payment_transactions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

