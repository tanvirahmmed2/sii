    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    student_id BIGINT NOT NULL REFERENCES website_students(id) ON DELETE CASCADE,
    exam_id BIGINT NOT NULL REFERENCES website_exams(id) ON DELETE CASCADE,
    subject_id BIGINT NOT NULL REFERENCES website_subjects(id) ON DELETE CASCADE,
    marks_obtained DECIMAL(5, 2) NOT NULL DEFAULT 0.00,
    total_marks DECIMAL(5, 2) NOT NULL DEFAULT 100.00,
    remarks VARCHAR(255),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT website_unique_student_exam_subject UNIQUE(website_id, student_id, exam_id, subject_id)
);

DROP TRIGGER IF EXISTS update_website_marks_updated_at ON website_marks;
