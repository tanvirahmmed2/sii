    BEFORE UPDATE ON website_officer_salary_payments
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- Subsystem Indexes
CREATE INDEX IF NOT EXISTS idx_ws_teacher_payrolls_ws ON website_teacher_payrolls(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_teacher_salaries_ws ON website_teacher_salaries(website_id, teacher_id);
CREATE INDEX IF NOT EXISTS idx_ws_teacher_salaries_pay ON website_teacher_salaries(payroll_id);
