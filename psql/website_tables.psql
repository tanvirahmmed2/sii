    room_id BIGINT NOT NULL REFERENCES website_hostel_rooms(id) ON DELETE CASCADE,
    seat_code VARCHAR(50) NOT NULL,
    one_time_fee NUMERIC(10, 2) DEFAULT 0.00 CHECK (one_time_fee >= 0.00),
    monthly_fee NUMERIC(10, 2) DEFAULT 0.00 CHECK (monthly_fee >= 0.00),
    status VARCHAR(50) DEFAULT 'available',
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, room_id, seat_code)
);

DROP TRIGGER IF EXISTS update_website_hostel_seats_updated_at ON website_hostel_seats;
