-- ----------------------------------------------------------------------------
-- 54. WEBSITE STUDENTS TABLE (Student Account & Authentication Master)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_students (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255),
    phone VARCHAR(50),
    registration_number VARCHAR(100) NOT NULL,
    password VARCHAR(255),
    recovery_token VARCHAR(255),
    recovery_token_expires TIMESTAMPTZ,
    verification_code VARCHAR(255),
    verification_code_expires TIMESTAMPTZ,
    is_active BOOLEAN DEFAULT FALSE,
    is_registered BOOLEAN DEFAULT FALSE,
    image TEXT,
    image_id VARCHAR(255),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, registration_number),
    UNIQUE(website_id, email)
);

DROP TRIGGER IF EXISTS update_website_students_updated_at ON website_students;
CREATE TRIGGER update_website_students_updated_at
    BEFORE UPDATE ON website_students
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 55. WEBSITE STUDENT INFORMATION TABLE (Student Details, Parents, Demographics)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_student_information (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    student_id BIGINT UNIQUE NOT NULL REFERENCES website_students(id) ON DELETE CASCADE,
    class_id BIGINT REFERENCES website_classes(id) ON DELETE SET NULL,
    section_id BIGINT REFERENCES website_sections(id) ON DELETE SET NULL,
    roll INT CHECK (roll > 0),
    date_of_birth DATE,
    gender VARCHAR(20) CHECK (gender IN ('Male', 'Female', 'Other')),
    blood_group VARCHAR(10),
    birth_certificate_number VARCHAR(100),
    address TEXT,
    parents_info TEXT,
    father_name VARCHAR(255),
    father_occupation VARCHAR(255),
    father_phone VARCHAR(50),
    mother_name VARCHAR(255),
    mother_occupation VARCHAR(255),
    mother_phone VARCHAR(50),
    guardian_name VARCHAR(255),
    guardian_phone VARCHAR(50),
    guardian_relationship VARCHAR(100),
    past_school_name VARCHAR(255),
    past_school_class VARCHAR(50),
    past_school_result VARCHAR(100),
    special_note TEXT,
    signature TEXT,
    signature_id VARCHAR(255),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, birth_certificate_number)
);

DROP TRIGGER IF EXISTS update_website_student_information_updated_at ON website_student_information;
CREATE TRIGGER update_website_student_information_updated_at
    BEFORE UPDATE ON website_student_information
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

