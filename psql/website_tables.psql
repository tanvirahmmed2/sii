-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_hostel_allocations (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    student_id BIGINT NOT NULL REFERENCES website_students(id) ON DELETE CASCADE,
    room_id BIGINT NOT NULL REFERENCES website_hostel_rooms(id) ON DELETE CASCADE,
    seat_id BIGINT REFERENCES website_hostel_seats(id) ON DELETE CASCADE,
    allocated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    vacated_at DATE,
    status VARCHAR(50) NOT NULL DEFAULT 'Active',
    allocated_by_role VARCHAR(50) DEFAULT 'admin',
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX IF NOT EXISTS website_unique_active_hostel_allocation 
    ON website_hostel_allocations(website_id, student_id) WHERE status = 'Active';

DROP TRIGGER IF EXISTS update_website_hostel_allocations_updated_at ON website_hostel_allocations;
