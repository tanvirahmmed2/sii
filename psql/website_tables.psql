-- ----------------------------------------------------------------------------
-- 74. WEBSITE ADMISSIONS TABLE (Admission Circulars)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_admissions (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    class_id BIGINT NOT NULL REFERENCES website_classes(id) ON DELETE CASCADE,
    min_age INT,
    max_age INT,
    birth_regi_number VARCHAR(100),
    admission_start_date DATE NOT NULL,
    finish_date DATE NOT NULL,
    result_date DATE,
    fees DECIMAL(10, 2) NOT NULL DEFAULT 0.00 CHECK (fees >= 0.00),
    description TEXT,
    is_result_published BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_admissions_updated_at ON website_admissions;
CREATE TRIGGER update_website_admissions_updated_at
    BEFORE UPDATE ON website_admissions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 75. WEBSITE STUDENT ADMISSIONS TABLE (Applications Submitted)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_student_admissions (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    admission_id BIGINT REFERENCES website_admissions(id) ON DELETE CASCADE,
    student_id BIGINT REFERENCES website_students(id) ON DELETE SET NULL,
    applicant_name VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL,
    phone VARCHAR(50) NOT NULL,
    date_of_birth DATE NOT NULL,
    gender VARCHAR(20) NOT NULL CHECK (gender IN ('Male', 'Female', 'Other')),
    blood_group VARCHAR(10),
    address TEXT NOT NULL,
    applied_class_id BIGINT NOT NULL REFERENCES website_classes(id) ON DELETE CASCADE,
    father_name VARCHAR(255),
    father_occupation VARCHAR(255),
    father_phone VARCHAR(50),
    mother_name VARCHAR(255),
    mother_occupation VARCHAR(255),
    mother_phone VARCHAR(50),
    past_school_name VARCHAR(255),
    past_school_class VARCHAR(50),
    past_school_result VARCHAR(100),
    special_note TEXT,
    previous_school TEXT,
    guardian_name VARCHAR(255) NOT NULL,
    guardian_phone VARCHAR(50) NOT NULL,
    birth_regi_number VARCHAR(100),
    image TEXT,
    image_id VARCHAR(255),
    signature TEXT,
    signature_id VARCHAR(255),
    status VARCHAR(50) DEFAULT 'incomplete' CHECK (status IN ('incomplete', 'pending', 'approved', 'rejected', 'selected', 'disqualified')),
    applied_date TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_student_admissions_updated_at ON website_student_admissions;
CREATE TRIGGER update_website_student_admissions_updated_at
    BEFORE UPDATE ON website_student_admissions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

