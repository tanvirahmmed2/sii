-- ============================================================================
-- TENANT WEBSITES SUBSCHEMA
-- Isolated Schema Definition for Tenant Educational Websites
-- Scoped by website_id & prefixed with website_
-- Extracted from psql/schema.psql
-- ============================================================================

-- Enable required extensions
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- ============================================================================
-- GLOBAL UTILITY FUNCTIONS & TRIGGERS
-- ============================================================================

CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;


-- ============================================================================
-- SECTION 2: TENANT TABLES (PREFIXED WITH website_, SCOPED BY website_id)
-- ============================================================================

-- ----------------------------------------------------------------------------
-- 25. WEBSITE SETTINGS TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_settings (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT UNIQUE NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    contact_phone VARCHAR(50),
    contact_email VARCHAR(255),
    address TEXT,
    map_url TEXT,
    motto TEXT,
    mission TEXT,
    vision TEXT,
    history TEXT,
    facebook_url TEXT,
    twitter_url TEXT,
    instagram_url TEXT,
    youtube_url TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_settings_updated_at ON website_settings;
CREATE TRIGGER update_website_settings_updated_at
    BEFORE UPDATE ON website_settings
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 26. WEBSITE HISTORIES TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_histories (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    description TEXT NOT NULL,
    date TIMESTAMPTZ NOT NULL,
    infor TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_histories_updated_at ON website_histories;
CREATE TRIGGER update_website_histories_updated_at
    BEFORE UPDATE ON website_histories
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 27. WEBSITE ACHIEVEMENTS TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_achievements (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    description TEXT NOT NULL,
    image_url TEXT,
    image_id TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_achievements_updated_at ON website_achievements;
CREATE TRIGGER update_website_achievements_updated_at
    BEFORE UPDATE ON website_achievements
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 28. WEBSITE RECOGNITIONS TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_recognitions (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(255) NOT NULL,
    slug VARCHAR(255) NOT NULL,
    description TEXT,
    awarded_by VARCHAR(255) NOT NULL,
    date DATE NOT NULL,
    image TEXT,
    image_id VARCHAR(255),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, slug)
);

DROP TRIGGER IF EXISTS update_website_recognitions_updated_at ON website_recognitions;
CREATE TRIGGER update_website_recognitions_updated_at
    BEFORE UPDATE ON website_recognitions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 29. WEBSITE COLLABORATIONS TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_collaborations (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    institution_name VARCHAR(255) NOT NULL,
    logo TEXT,
    logo_id VARCHAR(255),
    description TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_collaborations_updated_at ON website_collaborations;
CREATE TRIGGER update_website_collaborations_updated_at
    BEFORE UPDATE ON website_collaborations
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 30. WEBSITE STAFF PAY SCALE TABLE (Declared prior to website_staffs)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_staff_pay_scale (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    basic_salary NUMERIC(12, 2) NOT NULL DEFAULT 0.00 CHECK (basic_salary >= 0.00),
    allowance NUMERIC(12, 2) NOT NULL DEFAULT 0.00 CHECK (allowance >= 0.00),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, name)
);

DROP TRIGGER IF EXISTS update_website_staff_pay_scale_updated_at ON website_staff_pay_scale;
CREATE TRIGGER update_website_staff_pay_scale_updated_at
    BEFORE UPDATE ON website_staff_pay_scale
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 31. WEBSITE STAFFS TABLE (Admins, Registrars, Cashiers, General Staff)
-- (Unified institutional administration & operational staff table)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_staffs (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL,
    number VARCHAR(50) NOT NULL,
    address TEXT,
    password VARCHAR(255) NOT NULL,
    recovery_token VARCHAR(255),
    recovery_token_expires TIMESTAMPTZ,
    two_factor_code VARCHAR(10),
    two_factor_expires TIMESTAMPTZ,
    is_active BOOLEAN DEFAULT TRUE,
    is_registered BOOLEAN DEFAULT TRUE,
    is_two_factor_enabled BOOLEAN DEFAULT FALSE,
    verification_token VARCHAR(255),
    verification_token_expires TIMESTAMPTZ,
    grade_id BIGINT REFERENCES website_staff_pay_scale(id) ON DELETE SET NULL,
    date_of_birth DATE,
    nationality VARCHAR(100),
    blood_group VARCHAR(10),
    gender VARCHAR(20),
    nid_number VARCHAR(100),
    bio TEXT,
    username VARCHAR(255),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, email),
    UNIQUE(website_id, username)
);

DROP TRIGGER IF EXISTS update_website_staffs_updated_at ON website_staffs;
CREATE TRIGGER update_website_staffs_updated_at
    BEFORE UPDATE ON website_staffs
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 32. WEBSITE STAFF EXPERIENCES TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_staff_experiences (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    staff_id BIGINT NOT NULL REFERENCES website_staffs(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    organization VARCHAR(255) NOT NULL,
    start_date DATE,
    end_date DATE,
    is_current BOOLEAN DEFAULT FALSE,
    description TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_staff_experiences_updated_at ON website_staff_experiences;
CREATE TRIGGER update_website_staff_experiences_updated_at
    BEFORE UPDATE ON website_staff_experiences
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 32A. WEBSITE MODULES PERMISSIONS TABLE (Granular Module Access for Tenant Staff Only)
-- (Must check if available for the website via its subscription package)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_modules_permissions (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    staff_id BIGINT NOT NULL REFERENCES website_staffs(id) ON DELETE CASCADE,
    website_module_id BIGINT NOT NULL REFERENCES website_modules(id) ON DELETE CASCADE,
    can_view BOOLEAN DEFAULT TRUE,
    can_create BOOLEAN DEFAULT FALSE,
    can_edit BOOLEAN DEFAULT FALSE,
    can_delete BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(staff_id, website_module_id)
);

CREATE INDEX IF NOT EXISTS idx_website_modules_permissions_staff_id ON website_modules_permissions(staff_id);
CREATE INDEX IF NOT EXISTS idx_website_modules_permissions_website_id ON website_modules_permissions(website_id);
CREATE INDEX IF NOT EXISTS idx_website_modules_permissions_module_id ON website_modules_permissions(website_module_id);

DROP TRIGGER IF EXISTS update_website_modules_permissions_updated_at ON website_modules_permissions;
CREATE TRIGGER update_website_modules_permissions_updated_at
    BEFORE UPDATE ON website_modules_permissions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 32B. STAFF SESSIONS TABLE (Active Multi-Device Sessions for Tenant Staff)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS staff_sessions (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    staff_id BIGINT NOT NULL REFERENCES website_staffs(id) ON DELETE CASCADE,
    token TEXT UNIQUE NOT NULL,
    ip_address VARCHAR(45),
    user_agent TEXT,
    device_info TEXT,
    is_active BOOLEAN DEFAULT TRUE,
    expires_at TIMESTAMPTZ NOT NULL,
    last_active_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_staff_sessions_staff_id ON staff_sessions(staff_id);
CREATE INDEX IF NOT EXISTS idx_staff_sessions_website_id ON staff_sessions(website_id);
CREATE INDEX IF NOT EXISTS idx_staff_sessions_token ON staff_sessions(token);

DROP TRIGGER IF EXISTS update_staff_sessions_updated_at ON staff_sessions;
CREATE TRIGGER update_staff_sessions_updated_at
    BEFORE UPDATE ON staff_sessions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 33. WEBSITE AUTHORITY DESIGNATIONS TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_authority_designations (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    slug VARCHAR(255) NOT NULL,
    description TEXT,
    is_head BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, title),
    UNIQUE(website_id, slug)
);

DROP TRIGGER IF EXISTS update_website_authority_designations_updated_at ON website_authority_designations;
CREATE TRIGGER update_website_authority_designations_updated_at
    BEFORE UPDATE ON website_authority_designations
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 34. WEBSITE AUTHORITIES TABLE (Board Members, Managing Committee, Principals)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_authorities (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(255) NOT NULL,
    bio TEXT,
    designation_id BIGINT NOT NULL REFERENCES website_authority_designations(id) ON DELETE RESTRICT,
    email VARCHAR(255),
    contact VARCHAR(50),
    image TEXT,
    image_id VARCHAR(255),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, email)
);

DROP TRIGGER IF EXISTS update_website_authorities_updated_at ON website_authorities;
CREATE TRIGGER update_website_authorities_updated_at
    BEFORE UPDATE ON website_authorities
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 35. WEBSITE AUTHORITY QUALIFICATIONS TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_authority_qualifications (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    authority_id BIGINT NOT NULL REFERENCES website_authorities(id) ON DELETE CASCADE,
    degree VARCHAR(255) NOT NULL,
    institution VARCHAR(255) NOT NULL,
    passing_year INT NOT NULL,
    result VARCHAR(100),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_authority_qualifications_updated_at ON website_authority_qualifications;
CREATE TRIGGER update_website_authority_qualifications_updated_at
    BEFORE UPDATE ON website_authority_qualifications
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 36. WEBSITE DAYS TABLE (Academic Schedule Days)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_days (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(50) NOT NULL,
    status VARCHAR(10) CHECK(status IN ('on', 'off')) DEFAULT 'on',
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, name)
);

DROP TRIGGER IF EXISTS update_website_days_updated_at ON website_days;
CREATE TRIGGER update_website_days_updated_at
    BEFORE UPDATE ON website_days
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 37. WEBSITE PERIODS TABLE (Class Time Slots)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_periods (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    start_time VARCHAR(50) NOT NULL,
    end_time VARCHAR(50) NOT NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, name)
);

DROP TRIGGER IF EXISTS update_website_periods_updated_at ON website_periods;
CREATE TRIGGER update_website_periods_updated_at
    BEFORE UPDATE ON website_periods
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 38. WEBSITE CLASSES TABLE (Grades / Classes in the School)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_classes (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    numeric_name INT NOT NULL,
    code VARCHAR(50) NOT NULL,
    max_seats INT DEFAULT 40,
    description TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, name),
    UNIQUE(website_id, code)
);

DROP TRIGGER IF EXISTS update_website_classes_updated_at ON website_classes;
CREATE TRIGGER update_website_classes_updated_at
    BEFORE UPDATE ON website_classes
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 39. WEBSITE CLASS MONTHLY FEES TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_class_monthly_fees (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    class_id BIGINT NOT NULL REFERENCES website_classes(id) ON DELETE CASCADE,
    amount NUMERIC(10, 2) NOT NULL DEFAULT 0.00 CHECK (amount >= 0.00),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, class_id)
);

DROP TRIGGER IF EXISTS update_website_class_monthly_fees_updated_at ON website_class_monthly_fees;
CREATE TRIGGER update_website_class_monthly_fees_updated_at
    BEFORE UPDATE ON website_class_monthly_fees
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 40. WEBSITE SECTIONS TABLE (Class Sections / Batches)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_sections (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    class_id BIGINT NOT NULL REFERENCES website_classes(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    capacity INT DEFAULT 40,
    room_number VARCHAR(50),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, class_id, name)
);

DROP TRIGGER IF EXISTS update_website_sections_updated_at ON website_sections;
CREATE TRIGGER update_website_sections_updated_at
    BEFORE UPDATE ON website_sections
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 41. WEBSITE SUBJECTS TABLE (Courses / Subjects Taught)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_subjects (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    code VARCHAR(50) NOT NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, name),
    UNIQUE(website_id, code)
);

DROP TRIGGER IF EXISTS update_website_subjects_updated_at ON website_subjects;
CREATE TRIGGER update_website_subjects_updated_at
    BEFORE UPDATE ON website_subjects
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 42. WEBSITE CLASS SUBJECTS TABLE (Subject Mapping to Classes)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_class_subjects (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    class_id BIGINT NOT NULL REFERENCES website_classes(id) ON DELETE CASCADE,
    subject_id BIGINT NOT NULL REFERENCES website_subjects(id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, class_id, subject_id)
);

DROP TRIGGER IF EXISTS update_website_class_subjects_updated_at ON website_class_subjects;
CREATE TRIGGER update_website_class_subjects_updated_at
    BEFORE UPDATE ON website_class_subjects
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 43. WEBSITE TEACHER PAY SCALE TABLE (Declared prior to website_teachers)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_teacher_pay_scale (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    basic_salary NUMERIC(12, 2) NOT NULL DEFAULT 0.00 CHECK (basic_salary >= 0.00),
    allowance NUMERIC(12, 2) NOT NULL DEFAULT 0.00 CHECK (allowance >= 0.00),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, name)
);

DROP TRIGGER IF EXISTS update_website_teacher_pay_scale_updated_at ON website_teacher_pay_scale;
CREATE TRIGGER update_website_teacher_pay_scale_updated_at
    BEFORE UPDATE ON website_teacher_pay_scale
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 44. WEBSITE TEACHERS TABLE (Faculty Members)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_teachers (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL,
    number VARCHAR(50) NOT NULL,
    designation VARCHAR(255),
    address TEXT,
    password VARCHAR(255),
    recovery_token VARCHAR(255),
    recovery_token_expires TIMESTAMPTZ,
    is_active BOOLEAN DEFAULT FALSE,
    is_registered BOOLEAN DEFAULT FALSE,
    is_permanent BOOLEAN DEFAULT FALSE,
    image TEXT,
    image_id VARCHAR(255),
    grade_id BIGINT REFERENCES website_teacher_pay_scale(id) ON DELETE SET NULL,
    verification_token VARCHAR(255),
    verification_token_expires TIMESTAMPTZ,
    date_of_birth DATE,
    nationality VARCHAR(100),
    blood_group VARCHAR(10),
    gender VARCHAR(20),
    nid_number VARCHAR(100),
    bio TEXT,
    username VARCHAR(255),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, email),
    UNIQUE(website_id, username)
);

DROP TRIGGER IF EXISTS update_website_teachers_updated_at ON website_teachers;
CREATE TRIGGER update_website_teachers_updated_at
    BEFORE UPDATE ON website_teachers
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 45. WEBSITE TEACHER EXPERIENCES TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_teacher_experiences (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    teacher_id BIGINT NOT NULL REFERENCES website_teachers(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    organization VARCHAR(255) NOT NULL,
    start_date DATE,
    end_date DATE,
    is_current BOOLEAN DEFAULT FALSE,
    description TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_teacher_experiences_updated_at ON website_teacher_experiences;
CREATE TRIGGER update_website_teacher_experiences_updated_at
    BEFORE UPDATE ON website_teacher_experiences
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 46. WEBSITE TEACHER QUALIFICATIONS TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_teacher_qualifications (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    teacher_id BIGINT NOT NULL REFERENCES website_teachers(id) ON DELETE CASCADE,
    degree VARCHAR(255) NOT NULL,
    institution VARCHAR(255) NOT NULL,
    passing_year INT NOT NULL,
    result VARCHAR(100),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_teacher_qualifications_updated_at ON website_teacher_qualifications;
CREATE TRIGGER update_website_teacher_qualifications_updated_at
    BEFORE UPDATE ON website_teacher_qualifications
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 47. WEBSITE TEACHER SUBJECTS TABLE (Subject Expertise & Eligibility)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_teacher_subjects (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    teacher_id BIGINT NOT NULL REFERENCES website_teachers(id) ON DELETE CASCADE,
    subject_id BIGINT NOT NULL REFERENCES website_subjects(id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, teacher_id, subject_id)
);

DROP TRIGGER IF EXISTS update_website_teacher_subjects_updated_at ON website_teacher_subjects;
CREATE TRIGGER update_website_teacher_subjects_updated_at
    BEFORE UPDATE ON website_teacher_subjects
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 48. WEBSITE TEACHER CLASSES TABLE (Class Teacher Assignments)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_teacher_classes (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    teacher_id BIGINT NOT NULL REFERENCES website_teachers(id) ON DELETE CASCADE,
    class_id BIGINT NOT NULL REFERENCES website_classes(id) ON DELETE CASCADE,
    section_id BIGINT REFERENCES website_sections(id) ON DELETE CASCADE,
    academic_year VARCHAR(50) NOT NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, class_id, section_id, academic_year)
);

DROP TRIGGER IF EXISTS update_website_teacher_classes_updated_at ON website_teacher_classes;
CREATE TRIGGER update_website_teacher_classes_updated_at
    BEFORE UPDATE ON website_teacher_classes
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 49. WEBSITE CLASS SUBJECT TEACHERS TABLE (Subject-Teacher-Section Assignment)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_class_subject_teachers (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    class_subject_id BIGINT NOT NULL REFERENCES website_class_subjects(id) ON DELETE CASCADE,
    section_id BIGINT REFERENCES website_sections(id) ON DELETE CASCADE,
    teacher_id BIGINT NOT NULL REFERENCES website_teachers(id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX IF NOT EXISTS website_cst_unique_idx
  ON website_class_subject_teachers (website_id, class_subject_id, COALESCE(section_id, -1));

