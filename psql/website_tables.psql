    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    assignment_id BIGINT NOT NULL REFERENCES website_assignments(id) ON DELETE CASCADE,
    student_id BIGINT NOT NULL REFERENCES website_students(id) ON DELETE CASCADE,
    file_url TEXT,
    file_id VARCHAR(255),
    submission_text TEXT,
    submitted_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    marks_obtained DECIMAL(5, 2),
    remarks TEXT,
    status VARCHAR(50) NOT NULL DEFAULT 'Pending' CHECK (status IN ('Pending', 'Graded', 'Late', 'Resubmitted')),
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, assignment_id, student_id)
);

DROP TRIGGER IF EXISTS update_website_assignment_submissions_updated_at ON website_assignment_submissions;
CREATE TRIGGER update_website_assignment_submissions_updated_at
    BEFORE UPDATE ON website_assignment_submissions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 63. WEBSITE STUDENT FEES TABLE (Tuition, Exam & Term Invoices)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_student_fees (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    student_id BIGINT NOT NULL REFERENCES website_students(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    amount DECIMAL(10, 2) NOT NULL DEFAULT 0.00 CHECK (amount >= 0.00),
    due_date DATE NOT NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'unpaid' CHECK (LOWER(status) IN ('unpaid', 'paid', 'partially paid', 'pending', 'cancelled')),
    paid_amount DECIMAL(10, 2) NOT NULL DEFAULT 0.00 CHECK (paid_amount >= 0.00),
    payment_date TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_student_fees_updated_at ON website_student_fees;
CREATE TRIGGER update_website_student_fees_updated_at
    BEFORE UPDATE ON website_student_fees
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

