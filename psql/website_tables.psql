    BEFORE UPDATE ON website_teacher_class_periods
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ============================================================================
-- SECTION 3B: WEBSITE OFFICERS & PERMISSIONS TABLES
-- ============================================================================

-- ----------------------------------------------------------------------------
-- 36. WEBSITE OFFICERS (Provost, Librarian, Club Officer, Accounts, General Officers)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_officers (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL,
    phone VARCHAR(50) NOT NULL,
    department VARCHAR(100) DEFAULT 'General' CHECK (department IN ('Hall', 'Library', 'Club', 'Accounts', 'Administration', 'General', 'Hostel', 'Inventory')),
    designation VARCHAR(100) DEFAULT 'Officer',
    nid_number VARCHAR(100),
    gender VARCHAR(20) DEFAULT 'male' CHECK (gender IN ('male', 'female', 'other')),
    blood_group VARCHAR(10),
    date_of_birth DATE,
    religion VARCHAR(50),
    address TEXT,
    permanent_address TEXT,
    joining_date DATE DEFAULT CURRENT_DATE,
    salary NUMERIC(12, 2) DEFAULT 0.00 CHECK (salary >= 0.00),
    photo_url TEXT,
    photo_id VARCHAR(255),
    password VARCHAR(255) NOT NULL,
    recovery_token VARCHAR(255),
    recovery_token_expires TIMESTAMPTZ,
    two_factor_code VARCHAR(10),
    two_factor_expires TIMESTAMPTZ,
    is_active BOOLEAN DEFAULT TRUE,
    is_registered BOOLEAN DEFAULT FALSE,
    is_two_factor_enabled BOOLEAN DEFAULT FALSE,
    verification_token VARCHAR(255),
    verification_token_expires TIMESTAMPTZ,
    bio TEXT,
    username VARCHAR(255),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, email),
    UNIQUE(website_id, username)
);

DROP TRIGGER IF EXISTS update_website_officers_updated_at ON website_officers;
CREATE TRIGGER update_website_officers_updated_at
    BEFORE UPDATE ON website_officers
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 37. WEBSITE OFFICER PERMISSIONS (Module Granular Access Mapped from Packages)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_officer_permissions (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    officer_id BIGINT NOT NULL REFERENCES website_officers(id) ON DELETE CASCADE,
    website_module_id BIGINT NOT NULL REFERENCES website_modules(id) ON DELETE CASCADE,
    can_view BOOLEAN DEFAULT TRUE,
    can_create BOOLEAN DEFAULT FALSE,
    can_edit BOOLEAN DEFAULT FALSE,
    can_delete BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(officer_id, website_module_id)
);

DROP TRIGGER IF EXISTS update_website_officer_permissions_updated_at ON website_officer_permissions;
CREATE TRIGGER update_website_officer_permissions_updated_at
    BEFORE UPDATE ON website_officer_permissions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 37b. WEBSITE OFFICER LOGIN SESSIONS (Active Multi-Device Sessions)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_officer_login_sessions (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    officer_id BIGINT NOT NULL REFERENCES website_officers(id) ON DELETE CASCADE,
    token TEXT UNIQUE NOT NULL,
    ip_address VARCHAR(45),
    user_agent TEXT,
    device_info TEXT,
    is_active BOOLEAN DEFAULT TRUE,
    expires_at TIMESTAMPTZ NOT NULL,
    last_active_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_officer_login_sessions_updated_at ON website_officer_login_sessions;
CREATE TRIGGER update_website_officer_login_sessions_updated_at
    BEFORE UPDATE ON website_officer_login_sessions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ============================================================================
-- SECTION 4: PERFORMANCE INDEXES
-- ============================================================================

-- Staff Indexes
CREATE INDEX IF NOT EXISTS idx_ws_staffs_website ON website_staffs(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_staff_salaries_website ON website_staff_salaries(website_id, staff_id);
CREATE INDEX IF NOT EXISTS idx_ws_staff_attendance_lookup ON website_staff_attendance(website_id, staff_id, date);
CREATE INDEX IF NOT EXISTS idx_ws_staff_leaves_lookup ON website_staff_leaves(website_id, staff_id, status);
CREATE INDEX IF NOT EXISTS idx_ws_staff_applications_lookup ON website_staff_applications(website_id, staff_id, status);

-- Teacher Indexes
CREATE INDEX IF NOT EXISTS idx_ws_designations_website ON website_designations(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_teachers_website ON website_teachers(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_teachers_designation ON website_teachers(website_id, designation_id);
CREATE INDEX IF NOT EXISTS idx_ws_teachers_email ON website_teachers(website_id, email);
CREATE INDEX IF NOT EXISTS idx_ws_teachers_verification ON website_teachers(verification_token);
CREATE INDEX IF NOT EXISTS idx_ws_teachers_recovery ON website_teachers(recovery_token);
CREATE INDEX IF NOT EXISTS idx_ws_teacher_sessions_token ON website_teacher_login_sessions(token);
CREATE INDEX IF NOT EXISTS idx_ws_teacher_qual_teacher ON website_teacher_qualifications(website_id, teacher_id);
CREATE INDEX IF NOT EXISTS idx_ws_teacher_att_lookup ON website_teacher_attendance(website_id, teacher_id, date);
CREATE INDEX IF NOT EXISTS idx_ws_teacher_subjects_lookup ON website_teacher_subjects(website_id, teacher_id);
CREATE INDEX IF NOT EXISTS idx_ws_teacher_cp_lookup ON website_teacher_class_periods(website_id, teacher_id, day_id);

-- Officer Indexes
CREATE INDEX IF NOT EXISTS idx_ws_officers_website ON website_officers(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_officers_email ON website_officers(website_id, email);
CREATE INDEX IF NOT EXISTS idx_ws_officers_vtoken ON website_officers(verification_token);
CREATE INDEX IF NOT EXISTS idx_ws_officers_rtoken ON website_officers(recovery_token);
CREATE INDEX IF NOT EXISTS idx_ws_officer_perms_officer ON website_officer_permissions(officer_id);
CREATE INDEX IF NOT EXISTS idx_ws_officer_perms_website ON website_officer_permissions(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_officer_perms_module ON website_officer_permissions(website_module_id);
CREATE INDEX IF NOT EXISTS idx_ws_officer_sessions_token ON website_officer_login_sessions(token);
CREATE INDEX IF NOT EXISTS idx_ws_officer_sessions_lookup ON website_officer_login_sessions(website_id, officer_id, is_active);

-- Academic & Class Routine Indexes
CREATE INDEX IF NOT EXISTS idx_ws_sessions_website ON website_sessions(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_classes_website ON website_classes(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_sections_class ON website_sections(website_id, class_id);
CREATE INDEX IF NOT EXISTS idx_ws_subjects_website ON website_subjects(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_class_subjects_class ON website_class_subjects(website_id, class_id);
CREATE INDEX IF NOT EXISTS idx_ws_class_subjects_subject ON website_class_subjects(website_id, subject_id);
CREATE INDEX IF NOT EXISTS idx_ws_days_website ON website_days(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_periods_day ON website_periods(website_id, day_id);
CREATE INDEX IF NOT EXISTS idx_ws_pcs_period ON website_period_class_subjects(website_id, period_id);
CREATE INDEX IF NOT EXISTS idx_ws_pcs_class_subject ON website_period_class_subjects(website_id, class_subject_id);

-- Mailer, Meta & Messaging Indexes
CREATE INDEX IF NOT EXISTS idx_ws_brevo_mailer_website ON website_brevo_mailer(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_meta_website ON website_meta(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_meta_conv_website ON website_meta_conversations(website_id, platform);
CREATE INDEX IF NOT EXISTS idx_ws_meta_conv_lookup ON website_meta_conversations(website_id, platform, status);
CREATE INDEX IF NOT EXISTS idx_ws_meta_msg_conv ON website_meta_messages(conversation_id);
CREATE INDEX IF NOT EXISTS idx_ws_meta_msg_created ON website_meta_messages(created_at ASC);

-- Notices, Awards & News Indexes
CREATE INDEX IF NOT EXISTS idx_ws_notices_website ON website_notices(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_notices_active ON website_notices(website_id, is_active, published_date DESC);
CREATE INDEX IF NOT EXISTS idx_ws_awards_website ON website_awards(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_award_images_award ON website_award_images(award_id);
CREATE INDEX IF NOT EXISTS idx_ws_news_website ON website_news(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_news_published ON website_news(website_id, is_published, published_date DESC);
CREATE INDEX IF NOT EXISTS idx_ws_news_images_news ON website_news_images(news_id, display_order ASC);

-- ----------------------------------------------------------------------------
-- 38. WEBSITE STUDENTS TABLE (Core Academic Identity)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_students (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    registration_no VARCHAR(100) NOT NULL,
    class_id BIGINT REFERENCES website_classes(id) ON DELETE SET NULL,
    section_id BIGINT REFERENCES website_sections(id) ON DELETE SET NULL,
    session_id BIGINT REFERENCES website_sessions(id) ON DELETE SET NULL,
    roll_no VARCHAR(50),
    student_unique_id VARCHAR(100) NOT NULL,
    is_active BOOLEAN DEFAULT FALSE, -- Indicates whether setup is completed and student account is active
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, registration_no),
    UNIQUE(website_id, student_unique_id)
);

DROP TRIGGER IF EXISTS update_website_students_updated_at ON website_students;
CREATE TRIGGER update_website_students_updated_at
    BEFORE UPDATE ON website_students
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- View for singular reference
CREATE OR REPLACE VIEW website_student AS SELECT * FROM website_students;

-- ----------------------------------------------------------------------------
-- 38b. WEBSITE STUDENT INFO TABLE (Profile, Credentials & Security)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_student_info (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    student_id BIGINT NOT NULL REFERENCES website_students(id) ON DELETE CASCADE,
    name VARCHAR(255),
    email VARCHAR(255),
    number VARCHAR(50),
    gender VARCHAR(20) CHECK (gender IN ('Male', 'Female', 'Other')),
    blood_group VARCHAR(10),
    date_of_birth DATE,
    religion VARCHAR(50),
    admission_date DATE DEFAULT CURRENT_DATE,
    password TEXT NOT NULL,
    recovery_token VARCHAR(255),
    recovery_token_expires TIMESTAMPTZ,
    two_factor_code VARCHAR(50),
    two_factor_expires TIMESTAMPTZ,
    verification_token VARCHAR(255),
    verification_token_expires TIMESTAMPTZ,
    verification_status VARCHAR(50) DEFAULT 'pending_setup' CHECK (verification_status IN ('pending_setup', 'submitted', 'verified', 'rejected')),
    is_registered BOOLEAN DEFAULT FALSE,
    is_verified BOOLEAN DEFAULT FALSE,
    verified_by_staff_id BIGINT REFERENCES website_staffs(id) ON DELETE SET NULL,
    verified_at TIMESTAMPTZ,
    verification_notes TEXT,
    rejection_reason TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(student_id)
);

DROP TRIGGER IF EXISTS update_website_student_info_updated_at ON website_student_info;
CREATE TRIGGER update_website_student_info_updated_at
    BEFORE UPDATE ON website_student_info
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 39. WEBSITE STUDENT ADDRESSES TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_student_addresses (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    student_id BIGINT NOT NULL REFERENCES website_students(id) ON DELETE CASCADE,
    present_address TEXT,
    permanent_address TEXT,
    city VARCHAR(100),
    district VARCHAR(100),
    upazila VARCHAR(100),
    postal_code VARCHAR(50),
    country VARCHAR(100) DEFAULT 'Bangladesh',
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(student_id)
);

DROP TRIGGER IF EXISTS update_website_student_addresses_updated_at ON website_student_addresses;
CREATE TRIGGER update_website_student_addresses_updated_at
    BEFORE UPDATE ON website_student_addresses
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

