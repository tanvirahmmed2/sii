    name VARCHAR(255) NOT NULL,
    term VARCHAR(100),
    start_date DATE NOT NULL,
    end_date DATE NOT NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'upcoming' CHECK (status IN ('current', 'upcoming', 'previous')),
    class_id BIGINT REFERENCES website_classes(id) ON DELETE CASCADE,
    exam_fee NUMERIC(10, 2) DEFAULT 0.00 CHECK (exam_fee >= 0.00),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT website_unique_exam_per_class UNIQUE (website_id, name, class_id)
);

DROP TRIGGER IF EXISTS update_website_exams_updated_at ON website_exams;
CREATE TRIGGER update_website_exams_updated_at
    BEFORE UPDATE ON website_exams
