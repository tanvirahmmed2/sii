    name VARCHAR(255) NOT NULL,
    slug VARCHAR(255) NOT NULL,
    description TEXT,
    total_room INT NOT NULL DEFAULT 0,
    location VARCHAR(255),
    gender VARCHAR(50) DEFAULT 'Both',
    image TEXT,
    image_id VARCHAR(255),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, name),
    UNIQUE(website_id, slug)
);

DROP TRIGGER IF EXISTS update_website_hostels_updated_at ON website_hostels;
CREATE TRIGGER update_website_hostels_updated_at
    BEFORE UPDATE ON website_hostels
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 107. WEBSITE HOSTEL ROOMS TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_hostel_rooms (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    hostel_id BIGINT NOT NULL REFERENCES website_hostels(id) ON DELETE CASCADE,
    floor INT DEFAULT 1,
    room_number VARCHAR(100) NOT NULL,
    room_type VARCHAR(100) NOT NULL DEFAULT 'Standard',
    capacity INT NOT NULL DEFAULT 4,
    availability_status VARCHAR(50) NOT NULL DEFAULT 'Available',
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT website_unique_hostel_room UNIQUE(website_id, hostel_id, room_number)
);

DROP TRIGGER IF EXISTS update_website_hostel_rooms_updated_at ON website_hostel_rooms;
CREATE TRIGGER update_website_hostel_rooms_updated_at
    BEFORE UPDATE ON website_hostel_rooms
