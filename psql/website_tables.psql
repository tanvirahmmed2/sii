-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_suppliers (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(255) NOT NULL,
    contact_name VARCHAR(255),
    phone VARCHAR(50) NOT NULL,
    email VARCHAR(255),
    address TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_website_suppliers_updated_at ON website_suppliers;
CREATE TRIGGER update_website_suppliers_updated_at
    BEFORE UPDATE ON website_suppliers
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 123. WEBSITE INVENTORY ITEMS TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_inventory_items (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    category_id BIGINT NOT NULL REFERENCES website_inventory_categories(id) ON DELETE RESTRICT,
    name VARCHAR(255) NOT NULL,
    code VARCHAR(100) NOT NULL,
    description TEXT,
    total_quantity INT NOT NULL DEFAULT 0,
    available_quantity INT NOT NULL DEFAULT 0,
    unit VARCHAR(50) DEFAULT 'Pcs',
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, code)
);

DROP TRIGGER IF EXISTS update_website_inventory_items_updated_at ON website_inventory_items;
CREATE TRIGGER update_website_inventory_items_updated_at
    BEFORE UPDATE ON website_inventory_items
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 124. WEBSITE PURCHASES TABLE (School / Tenant Inventory Orders)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_purchases (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    supplier_id BIGINT NOT NULL REFERENCES website_suppliers(id) ON DELETE RESTRICT,
    purchase_number VARCHAR(100) NOT NULL,
    purchase_date DATE NOT NULL DEFAULT CURRENT_DATE,
    total_amount DECIMAL(10, 2) NOT NULL DEFAULT 0.00 CHECK (total_amount >= 0.00),
    paid_amount DECIMAL(10, 2) NOT NULL DEFAULT 0.00 CHECK (paid_amount >= 0.00),
    payment_status VARCHAR(50) DEFAULT 'Unpaid' CHECK (payment_status IN ('Paid', 'Unpaid', 'Partially Paid')),
    remarks TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, purchase_number)
);

DROP TRIGGER IF EXISTS update_website_purchases_updated_at ON website_purchases;
CREATE TRIGGER update_website_purchases_updated_at
    BEFORE UPDATE ON website_purchases
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 125. WEBSITE PURCHASE ITEMS TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_purchase_items (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    purchase_id BIGINT NOT NULL REFERENCES website_purchases(id) ON DELETE CASCADE,
    inventory_item_id BIGINT NOT NULL REFERENCES website_inventory_items(id) ON DELETE RESTRICT,
    quantity INT NOT NULL CHECK (quantity > 0),
    unit_price DECIMAL(10, 2) NOT NULL CHECK (unit_price >= 0),
    total_price DECIMAL(10, 2) NOT NULL CHECK (total_price >= 0),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- ----------------------------------------------------------------------------
-- 126. WEBSITE STOCK MOVEMENTS TABLE
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_stock_movements (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    inventory_item_id BIGINT NOT NULL REFERENCES website_inventory_items(id) ON DELETE CASCADE,
    quantity INT NOT NULL,
    movement_type VARCHAR(50) NOT NULL CHECK (movement_type IN ('Purchase', 'Issue', 'Return', 'Adjustment', 'Loss')),
    reference_id BIGINT,
    movement_date DATE NOT NULL DEFAULT CURRENT_DATE,
    handled_by VARCHAR(255),
    remarks TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- ----------------------------------------------------------------------------
-- 127. WEBSITE LOGIN LOGS TABLE (Tenant User Audit Trail)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_login_logs (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    user_id BIGINT NOT NULL,
    user_type VARCHAR(50) NOT NULL CHECK (user_type IN ('staff', 'teacher', 'student', 'guardian')),
    name VARCHAR(255),
    email VARCHAR(255),
    login_time TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    ip_address VARCHAR(100),
    user_agent TEXT,
    status VARCHAR(50) NOT NULL DEFAULT 'Success' CHECK (status IN ('Success', 'Failed')),
    failure_reason VARCHAR(255),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- ----------------------------------------------------------------------------
-- 128. WEBSITE ACTIVITY LOGS TABLE (Tenant Action Audit Trail)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_activity_logs (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    user_id BIGINT,
    user_type VARCHAR(50) NOT NULL,
    user_name VARCHAR(255),
    action VARCHAR(255) NOT NULL,
    entity_type VARCHAR(100),
    entity_id BIGINT,
    details JSONB,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);


-- ============================================================================
-- SECTION 3: TENANT PERFORMANCE INDEXES
-- Optimizes queries filtering by website_id & foreign keys
-- ============================================================================

-- Tenant Foreign Key & Isolation Indexes
CREATE INDEX IF NOT EXISTS idx_ws_staffs_website ON website_staffs(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_classes_website ON website_classes(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_sections_class ON website_sections(website_id, class_id);
CREATE INDEX IF NOT EXISTS idx_ws_teachers_website ON website_teachers(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_teachers_grade ON website_teachers(grade_id);
CREATE INDEX IF NOT EXISTS idx_ws_subjects_website ON website_subjects(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_class_subjects_class ON website_class_subjects(website_id, class_id);
CREATE INDEX IF NOT EXISTS idx_ws_students_website ON website_students(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_students_reg ON website_students(website_id, registration_number);
CREATE INDEX IF NOT EXISTS idx_ws_student_info_student ON website_student_information(student_id);
CREATE INDEX IF NOT EXISTS idx_ws_student_info_class ON website_student_information(website_id, class_id, section_id);
CREATE INDEX IF NOT EXISTS idx_ws_student_attendances_date ON website_student_attendances(website_id, class_id, date);
CREATE INDEX IF NOT EXISTS idx_ws_student_attendances_student ON website_student_attendances(student_id, date);
CREATE INDEX IF NOT EXISTS idx_ws_student_fees_student ON website_student_fees(website_id, student_id, status);
CREATE INDEX IF NOT EXISTS idx_ws_student_fee_payments_fee ON website_student_fee_payments(student_fee_id);
CREATE INDEX IF NOT EXISTS idx_ws_marks_exam_subject ON website_marks(website_id, exam_id, subject_id);
CREATE INDEX IF NOT EXISTS idx_ws_marks_student ON website_marks(student_id, exam_id);
CREATE INDEX IF NOT EXISTS idx_ws_results_exam ON website_results(website_id, exam_id);
CREATE INDEX IF NOT EXISTS idx_ws_class_routines_lookup ON website_class_routines(website_id, class_id, section_id);
CREATE INDEX IF NOT EXISTS idx_ws_admissions_website ON website_admissions(website_id);
CREATE INDEX IF NOT EXISTS idx_ws_student_admissions_adm ON website_student_admissions(website_id, admission_id);
CREATE INDEX IF NOT EXISTS idx_ws_hostel_allocations_room ON website_hostel_allocations(website_id, room_id);
CREATE INDEX IF NOT EXISTS idx_ws_hostel_allocations_student ON website_hostel_allocations(website_id, student_id);
CREATE INDEX IF NOT EXISTS idx_ws_activity_logs_website ON website_activity_logs(website_id, created_at DESC);
CREATE INDEX IF NOT EXISTS idx_ws_login_logs_website ON website_login_logs(website_id, login_time DESC);
