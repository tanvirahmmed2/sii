    student_id BIGINT NOT NULL REFERENCES website_students(id) ON DELETE CASCADE,
    from_seat_id BIGINT REFERENCES website_hostel_seats(id) ON DELETE SET NULL,
    to_seat_id BIGINT NOT NULL REFERENCES website_hostel_seats(id) ON DELETE CASCADE,
    transferred_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    reason TEXT,
    transferred_by VARCHAR(50) DEFAULT 'admin',
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

