-- ============================================================================
-- SAAS EDUCATIONAL WEBSITE DEVELOPER COMPANY PLATFORM
-- Multi-Tenant Database Architecture & Schema Definition
-- Main SaaS Platform & Company Operations Schema
-- ============================================================================

-- Enable required extensions
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- ============================================================================
-- GLOBAL UTILITY FUNCTIONS & TRIGGERS
-- ============================================================================

-- Function to automatically update updated_at timestamp on row modification
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;


-- ============================================================================
-- SECTION 1: MAIN SAAS COMPANY / PLATFORM TABLES
-- (Super-Admin, Developers, Role Permissions, Packages, Modules, Billing, Support & FAQs)
-- ============================================================================

-- ----------------------------------------------------------------------------
-- 1. DEVELOPER MODULES TABLE (Main Website System Modules for Permissions)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS developer_modules (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(100) UNIQUE NOT NULL,
    slug VARCHAR(100) UNIQUE NOT NULL,
    description TEXT,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_developer_modules_updated_at ON developer_modules;
CREATE TRIGGER update_developer_modules_updated_at
    BEFORE UPDATE ON developer_modules
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 2. MODULE PERMISSIONS TABLE (Granular Permissions inside Developer Modules)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS module_permissions (
    id BIGSERIAL PRIMARY KEY,
    module_id BIGINT NOT NULL REFERENCES developer_modules(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    permission_key VARCHAR(100) NOT NULL,
    description TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(module_id, permission_key)
);

-- ----------------------------------------------------------------------------
-- 3. DEVELOPER ROLES TABLE (SaaS Platform Internal Roles)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS developer_roles (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(100) UNIQUE NOT NULL,
    slug VARCHAR(100) UNIQUE NOT NULL,
    description TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_developer_roles_updated_at ON developer_roles;
CREATE TRIGGER update_developer_roles_updated_at
    BEFORE UPDATE ON developer_roles
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 4. DEVELOPER ROLE PERMISSIONS TABLE (Role-to-Permission Mapping)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS developer_role_permissions (
    id BIGSERIAL PRIMARY KEY,
    role_id BIGINT NOT NULL REFERENCES developer_roles(id) ON DELETE CASCADE,
    permission_id BIGINT NOT NULL REFERENCES module_permissions(id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(role_id, permission_id)
);

-- ----------------------------------------------------------------------------
-- 5. DEVELOPERS TABLE (SaaS Company Engineers, Admins & Staff)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS developers (
    id BIGSERIAL PRIMARY KEY,
    role_id BIGINT REFERENCES developer_roles(id) ON DELETE SET NULL,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) UNIQUE NOT NULL,
    phone VARCHAR(50),
    designation VARCHAR(100) DEFAULT 'Software Engineer',
    password VARCHAR(255) NOT NULL,
    avatar_url TEXT,
    avatar_id VARCHAR(255),
    bio TEXT,
    github_profile VARCHAR(255),
    linkedin_profile VARCHAR(255),
    is_active BOOLEAN DEFAULT TRUE,
    email_verified BOOLEAN DEFAULT FALSE,
    verification_token VARCHAR(255),
    verification_token_expires TIMESTAMPTZ,
    two_factor_code VARCHAR(10),
    two_factor_expires TIMESTAMPTZ,
    recovery_token VARCHAR(255),
    recovery_token_expires TIMESTAMPTZ,
    last_login_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_developers_updated_at ON developers;
CREATE TRIGGER update_developers_updated_at
    BEFORE UPDATE ON developers
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 6. DEVELOPER LOGIN ACTIVITIES TABLE (Developer Login Audit Trail)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS developer_login_activities (
    id BIGSERIAL PRIMARY KEY,
    developer_id BIGINT NOT NULL REFERENCES developers(id) ON DELETE CASCADE,
    ip_address VARCHAR(100),
    user_agent TEXT,
    status VARCHAR(50) NOT NULL DEFAULT 'Success' CHECK (status IN ('Success', 'Failed')),
    failure_reason VARCHAR(255),
    login_time TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- ----------------------------------------------------------------------------
-- 7. DEVELOPER LOGIN SESSIONS TABLE (Active Developer Auth Sessions)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS developer_login_sessions (
    id BIGSERIAL PRIMARY KEY,
    developer_id BIGINT NOT NULL REFERENCES developers(id) ON DELETE CASCADE,
    token TEXT UNIQUE NOT NULL,
    ip_address VARCHAR(100),
    user_agent TEXT,
    expires_at TIMESTAMPTZ NOT NULL,
    is_active BOOLEAN DEFAULT TRUE,
    last_active_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_developer_login_sessions_updated_at ON developer_login_sessions;
CREATE TRIGGER update_developer_login_sessions_updated_at
    BEFORE UPDATE ON developer_login_sessions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 8. PACKAGES TABLE (Subscription Pricing Plans for Schools/Clients)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS packages (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(100) UNIQUE NOT NULL,
    slug VARCHAR(100) UNIQUE NOT NULL,
    tagline VARCHAR(255),
    description TEXT,
    monthly_price_usd DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (monthly_price_usd >= 0.00),
    yearly_price_usd DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (yearly_price_usd >= 0.00),
    monthly_price_bdt DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (monthly_price_bdt >= 0.00),
    yearly_price_bdt DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (yearly_price_bdt >= 0.00),
    monthly_price DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (monthly_price >= 0.00),
    yearly_price DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (yearly_price >= 0.00),
    discount_percentage DECIMAL(5, 2) DEFAULT 0.00 CHECK (discount_percentage >= 0.00 AND discount_percentage <= 100.00),
    max_students INT DEFAULT 500,
    max_teachers INT DEFAULT 30,
    max_staff INT DEFAULT 20,
    max_storage_mb INT DEFAULT 5120,
    max_websites INT DEFAULT 1,
    features JSONB DEFAULT '[]'::jsonb,
    is_popular BOOLEAN DEFAULT FALSE,
    is_public BOOLEAN DEFAULT TRUE,
    is_active BOOLEAN DEFAULT TRUE,
    grace_period INT DEFAULT 3,
    sort_order INT DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- Idempotent column migrations for existing packages table
ALTER TABLE packages ADD COLUMN IF NOT EXISTS monthly_price_usd DECIMAL(12, 2) NOT NULL DEFAULT 0.00;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS yearly_price_usd DECIMAL(12, 2) NOT NULL DEFAULT 0.00;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS monthly_price_bdt DECIMAL(12, 2) NOT NULL DEFAULT 0.00;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS yearly_price_bdt DECIMAL(12, 2) NOT NULL DEFAULT 0.00;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS max_websites INT DEFAULT 1;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS is_public BOOLEAN DEFAULT TRUE;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS grace_period INT DEFAULT 3;
ALTER TABLE packages DROP COLUMN IF EXISTS trial_days;

CREATE INDEX IF NOT EXISTS idx_packages_public ON packages(is_public, is_active, sort_order);

DROP TRIGGER IF EXISTS update_packages_updated_at ON packages;
CREATE TRIGGER update_packages_updated_at
    BEFORE UPDATE ON packages
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 9. TENANT MODULES TABLE (Tenant Features / School System Modules Catalog)
-- e.g., Attendance, Exams, LMS, Hostel, Fees, Accounting, Inventory
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS tenant_modules (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(100) UNIQUE NOT NULL,
    slug VARCHAR(100) UNIQUE NOT NULL,
    description TEXT,
    icon VARCHAR(100),
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_tenant_modules_updated_at ON tenant_modules;
CREATE TRIGGER update_tenant_modules_updated_at
    BEFORE UPDATE ON tenant_modules
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();


-- ----------------------------------------------------------------------------
-- 10. PACKAGE MODULES TABLE (Tenant Modules included in Packages)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS package_modules (
    id BIGSERIAL PRIMARY KEY,
    package_id BIGINT NOT NULL REFERENCES packages(id) ON DELETE CASCADE,
    tenant_module_id BIGINT NOT NULL REFERENCES tenant_modules(id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(package_id, tenant_module_id)
);

-- ----------------------------------------------------------------------------
-- 11. CREATORS TABLE (Clients / Educational Institution Owners / Customers)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS creators (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) UNIQUE NOT NULL,
    phone VARCHAR(50),
    institution VARCHAR(255),
    country VARCHAR(100),
    city VARCHAR(100),
    address TEXT,
    password VARCHAR(255) NOT NULL,
    email_verified BOOLEAN DEFAULT FALSE,
    verification_token VARCHAR(255),
    verification_token_expires TIMESTAMPTZ,
    recovery_token VARCHAR(255),
    recovery_token_expires TIMESTAMPTZ,
    two_factor_code VARCHAR(10),
    two_factor_expires TIMESTAMPTZ,
    is_active BOOLEAN DEFAULT TRUE,
    last_login_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_creators_updated_at ON creators;
CREATE TRIGGER update_creators_updated_at
    BEFORE UPDATE ON creators
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 11B. CREATOR LOGIN SESSIONS TABLE (Active Creator Auth Sessions)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS creator_login_sessions (
    id BIGSERIAL PRIMARY KEY,
    creator_id BIGINT NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    token TEXT UNIQUE NOT NULL,
    ip_address VARCHAR(100),
    user_agent TEXT,
    expires_at TIMESTAMPTZ NOT NULL,
    is_active BOOLEAN DEFAULT TRUE,
    last_active_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE OR REPLACE VIEW creator_login_session AS SELECT * FROM creator_login_sessions;

DROP TRIGGER IF EXISTS update_creator_login_sessions_updated_at ON creator_login_sessions;
CREATE TRIGGER update_creator_login_sessions_updated_at
    BEFORE UPDATE ON creator_login_sessions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 12. SUBSCRIBERS TABLE (Marketing & Newsletter Subscribers)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS subscribers (
    id BIGSERIAL PRIMARY KEY,
    email VARCHAR(255) UNIQUE NOT NULL,
    name VARCHAR(255),
    source VARCHAR(100) DEFAULT 'website',
    is_active BOOLEAN DEFAULT TRUE,
    subscribed_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    unsubscribed_at TIMESTAMPTZ
);

-- ----------------------------------------------------------------------------
-- 13. WEBSITES TABLE (TENANTS MASTER TABLE)
-- Represents individual educational institution websites hosted on SaaS
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS websites (
    id BIGSERIAL PRIMARY KEY,
    creator_id BIGINT NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    package_id BIGINT REFERENCES packages(id) ON DELETE SET NULL,
    name VARCHAR(255) NOT NULL,
    slug VARCHAR(100) UNIQUE NOT NULL,
    subdomain VARCHAR(100) UNIQUE NOT NULL,
    custom_domain VARCHAR(255) UNIQUE,
    custom_domain_verified BOOLEAN DEFAULT FALSE,
    institution_type VARCHAR(100) DEFAULT 'School',
    eiin_number VARCHAR(100),
    status VARCHAR(50) NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'pending', 'suspended', 'expired', 'archived')),
    theme VARCHAR(100) DEFAULT 'default',
    primary_color VARCHAR(50) DEFAULT '#1e40af',
    logo TEXT,
    logo_id VARCHAR(255),
    favicon TEXT,
    favicon_id VARCHAR(255),
    contact_email VARCHAR(255),
    contact_phone VARCHAR(50),
    address TEXT,
    subscription_expires_at TIMESTAMPTZ,
    storage_used_mb INT DEFAULT 0,
    is_maintenance_mode BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_websites_updated_at ON websites;
CREATE TRIGGER update_websites_updated_at
    BEFORE UPDATE ON websites
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 14. WEBSITE MODULES TABLE (Tenant Modules activated per Website)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_modules (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    tenant_module_id BIGINT NOT NULL REFERENCES tenant_modules(id) ON DELETE CASCADE,
    is_enabled BOOLEAN DEFAULT TRUE,
    enabled_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(website_id, tenant_module_id)
);

-- ----------------------------------------------------------------------------
-- 15. PURCHASES TABLE (Package Subscriptions & Module Purchases by Creators)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS purchases (
    id BIGSERIAL PRIMARY KEY,
    creator_id BIGINT NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    website_id BIGINT REFERENCES websites(id) ON DELETE SET NULL,
    package_id BIGINT REFERENCES packages(id) ON DELETE SET NULL,
    purchase_code VARCHAR(100) UNIQUE NOT NULL,
    billing_cycle VARCHAR(50) NOT NULL DEFAULT 'monthly' CHECK (billing_cycle IN ('monthly', 'yearly', 'lifetime', 'custom')),
    base_amount DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (base_amount >= 0.00),
    discount_amount DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (discount_amount >= 0.00),
    tax_amount DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (tax_amount >= 0.00),
    total_amount DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (total_amount >= 0.00),
    status VARCHAR(50) NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'completed', 'failed', 'refunded', 'cancelled')),
    period_start TIMESTAMPTZ,
    period_end TIMESTAMPTZ,
    invoice_pdf_url TEXT,
    notes TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_purchases_updated_at ON purchases;
CREATE TRIGGER update_purchases_updated_at
    BEFORE UPDATE ON purchases
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 16. PAYMENTS TABLE (Financial Transactions for SaaS Subscriptions)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS payments (
    id BIGSERIAL PRIMARY KEY,
    purchase_id BIGINT NOT NULL REFERENCES purchases(id) ON DELETE CASCADE,
    creator_id BIGINT NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    transaction_id VARCHAR(100) UNIQUE NOT NULL,
    amount DECIMAL(12, 2) NOT NULL CHECK (amount >= 0.00),
    currency VARCHAR(10) NOT NULL DEFAULT 'USD',
    payment_method VARCHAR(100) NOT NULL DEFAULT 'Stripe',
    payment_gateway VARCHAR(100),
    gateway_fee DECIMAL(10, 2) DEFAULT 0.00 CHECK (gateway_fee >= 0.00),
    gateway_response JSONB,
    status VARCHAR(50) NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'successful', 'failed', 'refunded', 'cancelled')),
    payment_date TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_payments_updated_at ON payments;
CREATE TRIGGER update_payments_updated_at
    BEFORE UPDATE ON payments
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 16.1. WISHLISTS TABLE (Package Wishlists / Saved Plans by Creators)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS wishlists (
    id BIGSERIAL PRIMARY KEY,
    creator_id BIGINT NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    package_id BIGINT NOT NULL REFERENCES packages(id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(creator_id, package_id)
);

CREATE OR REPLACE VIEW wishlist AS SELECT * FROM wishlists;

DROP TRIGGER IF EXISTS update_wishlists_updated_at ON wishlists;
CREATE TRIGGER update_wishlists_updated_at
    BEFORE UPDATE ON wishlists
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 16.2. SUBSCRIPTIONS TABLE (Active Educational Website Subscriptions)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS subscriptions (
    id BIGSERIAL PRIMARY KEY,
    creator_id BIGINT NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    website_id BIGINT REFERENCES websites(id) ON DELETE SET NULL,
    package_id BIGINT NOT NULL REFERENCES packages(id) ON DELETE CASCADE,
    purchase_id BIGINT REFERENCES purchases(id) ON DELETE SET NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'trailing', 'past_due', 'cancelled', 'expired')),
    billing_cycle VARCHAR(50) NOT NULL DEFAULT 'monthly' CHECK (billing_cycle IN ('monthly', 'yearly', 'lifetime', 'custom')),
    current_period_start TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    current_period_end TIMESTAMPTZ,
    cancel_at_period_end BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE OR REPLACE VIEW subscription AS SELECT * FROM subscriptions;

DROP TRIGGER IF EXISTS update_subscriptions_updated_at ON subscriptions;
CREATE TRIGGER update_subscriptions_updated_at
    BEFORE UPDATE ON subscriptions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 17. BLOGS TABLE (SaaS Platform Company Blog & Educational Articles)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS blogs (
    id BIGSERIAL PRIMARY KEY,
    developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    title VARCHAR(255) NOT NULL,
    slug VARCHAR(255) UNIQUE NOT NULL,
    excerpt TEXT,
    content TEXT NOT NULL,
    category VARCHAR(100),
    meta_title VARCHAR(255),
    meta_description TEXT,
    is_published BOOLEAN DEFAULT FALSE,
    published_at TIMESTAMPTZ,
    views_count INT DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_blogs_updated_at ON blogs;
CREATE TRIGGER update_blogs_updated_at
    BEFORE UPDATE ON blogs
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 17.1 BLOG IMAGES TABLE (Gallery & Featured Images for Blogs)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS blog_images (
    id BIGSERIAL PRIMARY KEY,
    blog_id BIGINT NOT NULL REFERENCES blogs(id) ON DELETE CASCADE,
    image TEXT NOT NULL,
    image_id VARCHAR(255),
    caption TEXT,
    is_primary BOOLEAN DEFAULT FALSE,
    display_order INT DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_blog_images_blog_id ON blog_images(blog_id);

-- ----------------------------------------------------------------------------
-- 18. CONTACTS TABLE (Lead Inquiries submitted on Main SaaS Website)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS contacts (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL,
    phone VARCHAR(50),
    institution VARCHAR(255),
    subject VARCHAR(255) NOT NULL,
    message TEXT NOT NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'new' CHECK (status IN ('new', 'read', 'in_progress', 'replied', 'closed')),
    assigned_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    admin_notes TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_contacts_updated_at ON contacts;
CREATE TRIGGER update_contacts_updated_at
    BEFORE UPDATE ON contacts
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 19. REVIEWS TABLE (Client Testimonials & Reviews for SaaS Platform)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS reviews (
    id BIGSERIAL PRIMARY KEY,
    creator_id BIGINT REFERENCES creators(id) ON DELETE SET NULL,
    website_id BIGINT REFERENCES websites(id) ON DELETE SET NULL,
    reviewer_name VARCHAR(255) NOT NULL,
    institution_name VARCHAR(255),
    rating INT NOT NULL CHECK (rating >= 1 AND rating <= 5),
    title VARCHAR(255),
    review_text TEXT NOT NULL,
    is_featured BOOLEAN DEFAULT FALSE,
    is_approved BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_reviews_updated_at ON reviews;
CREATE TRIGGER update_reviews_updated_at
    BEFORE UPDATE ON reviews
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 20. POLICIES TABLE (Platform Legal Documents: Privacy, Terms, SLA, etc.)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS policies (
    id BIGSERIAL PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    slug VARCHAR(255) UNIQUE NOT NULL,
    description TEXT NOT NULL,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_policies_updated_at ON policies;
CREATE TRIGGER update_policies_updated_at
    BEFORE UPDATE ON policies
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 21. FAQ TABLE (Frequently Asked Questions for Main SaaS Website)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS faq (
    id BIGSERIAL PRIMARY KEY,
    question TEXT NOT NULL,
    answer TEXT NOT NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_faq_updated_at ON faq;
CREATE TRIGGER update_faq_updated_at
    BEFORE UPDATE ON faq
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 21.1 UPDATES TABLE (SaaS Platform Product Releases, Changelog & Roadmap)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS updates (
    id BIGSERIAL PRIMARY KEY,
    version VARCHAR(50) NOT NULL,
    title VARCHAR(255) NOT NULL,
    slug VARCHAR(255) UNIQUE,
    description TEXT,
    changelog TEXT,
    release_date DATE DEFAULT CURRENT_DATE,
    is_published BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_updates_updated_at ON updates;
CREATE TRIGGER update_updates_updated_at
    BEFORE UPDATE ON updates
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 21.2 TUTORIALS TABLE (Video Guides, Platform Walkthroughs & Documentation)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS tutorials (
    id BIGSERIAL PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    description TEXT,
    youtube_link VARCHAR(500) NOT NULL,
    is_published BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_tutorials_updated_at ON tutorials;
CREATE TRIGGER update_tutorials_updated_at
    BEFORE UPDATE ON tutorials
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 21.3. REPORTS TABLE (Platform Content Moderation & Abuse Reports)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS reports (
    id BIGSERIAL PRIMARY KEY,
    reporter_name VARCHAR(255) NOT NULL,
    reporter_email VARCHAR(255) NOT NULL,
    subject VARCHAR(255) NOT NULL,
    description TEXT NOT NULL,
    category VARCHAR(50) DEFAULT 'GENERAL',
    priority VARCHAR(50) DEFAULT 'MEDIUM',
    status VARCHAR(50) DEFAULT 'OPEN',
    admin_response TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_reports_updated_at ON reports;
CREATE TRIGGER update_reports_updated_at
    BEFORE UPDATE ON reports
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 22. SUPPORTS TABLE (Support Tickets & Helpdesk Sessions)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS supports (
    id BIGSERIAL PRIMARY KEY,
    creator_id BIGINT NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    website_id BIGINT REFERENCES websites(id) ON DELETE SET NULL,
    assigned_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    ticket_number VARCHAR(100) UNIQUE NOT NULL,
    subject VARCHAR(255) NOT NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'open' CHECK (status IN ('open', 'in_progress', 'waiting_for_user', 'resolved', 'closed')),
    priority VARCHAR(50) NOT NULL DEFAULT 'medium' CHECK (priority IN ('low', 'medium', 'high', 'urgent')),
    last_message_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_supports_updated_at ON supports;
CREATE TRIGGER update_supports_updated_at
    BEFORE UPDATE ON supports
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 23. SUPPORT MESSAGES TABLE (Individual Messages inside Support Chats)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS support_messages (
    id BIGSERIAL PRIMARY KEY,
    support_id BIGINT NOT NULL REFERENCES supports(id) ON DELETE CASCADE,
    sender_type VARCHAR(50) NOT NULL CHECK (sender_type IN ('creator', 'developer', 'system')),
    sender_id BIGINT NOT NULL,
    message TEXT,
    is_internal_note BOOLEAN DEFAULT FALSE,
    is_read BOOLEAN DEFAULT FALSE,
    read_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- ----------------------------------------------------------------------------
-- 24. SUPPORT IMAGES TABLE (Image Attachments for Support Messages)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS support_images (
    id BIGSERIAL PRIMARY KEY,
    message_id BIGINT NOT NULL REFERENCES support_messages(id) ON DELETE CASCADE,
    image_url TEXT NOT NULL,
    image_id VARCHAR(255),
    file_name VARCHAR(255),
    file_size INT,
    mime_type VARCHAR(100),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- ----------------------------------------------------------------------------
-- 25. LIVE CHATS TABLE (Real-time Live Chat Sessions for Visitors & Leads)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS live_chats (
    id BIGSERIAL PRIMARY KEY,
    session_id VARCHAR(255) UNIQUE NOT NULL,
    visitor_name VARCHAR(255) NOT NULL,
    visitor_email VARCHAR(255),
    visitor_phone VARCHAR(50),
    ip_address VARCHAR(100),
    user_agent TEXT,
    creator_id BIGINT REFERENCES creators(id) ON DELETE SET NULL,
    website_id BIGINT REFERENCES websites(id) ON DELETE SET NULL,
    assigned_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    status VARCHAR(50) DEFAULT 'OPEN',
    started_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    ended_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_live_chats_updated_at ON live_chats;
CREATE TRIGGER update_live_chats_updated_at
    BEFORE UPDATE ON live_chats
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- Alias view for singular queries (e.g., live_chat)
CREATE OR REPLACE VIEW live_chat AS SELECT * FROM live_chats;

-- ----------------------------------------------------------------------------
-- 26. LIVE CHAT MESSAGES TABLE (Real-time Live Chat Message Stream)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS live_chat_messages (
    id BIGSERIAL PRIMARY KEY,
    chat_id BIGINT NOT NULL REFERENCES live_chats(id) ON DELETE CASCADE,
    sender_type VARCHAR(50) DEFAULT 'VISITOR',
    sender_id BIGINT,
    sender_name VARCHAR(255) NOT NULL DEFAULT 'Visitor',
    message TEXT NOT NULL,
    attachment_url TEXT,
    is_read BOOLEAN DEFAULT FALSE,
    read_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- Alias view for singular queries (e.g., live_chat_message)
CREATE OR REPLACE VIEW live_chat_message AS SELECT * FROM live_chat_messages;

-- ----------------------------------------------------------------------------
-- 27. INTERNAL CHATS TABLE (Internal Staff & Developer 1-on-1 and Group Chats)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS internal_chats (
    id BIGSERIAL PRIMARY KEY,
    title VARCHAR(255),
    type VARCHAR(50) NOT NULL DEFAULT 'DIRECT' CHECK (type IN ('DIRECT', 'GROUP', 'direct', 'group')),
    created_by_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_internal_chats_updated_at ON internal_chats;
CREATE TRIGGER update_internal_chats_updated_at
    BEFORE UPDATE ON internal_chats
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 28. CHAT PARTICIPANTS TABLE (Staff Participants in Internal Chats)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS chat_participants (
    id BIGSERIAL PRIMARY KEY,
    chat_id BIGINT NOT NULL REFERENCES internal_chats(id) ON DELETE CASCADE,
    developer_id BIGINT NOT NULL REFERENCES developers(id) ON DELETE CASCADE,
    last_read_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (chat_id, developer_id)
);

-- ----------------------------------------------------------------------------
-- 29. CHAT MESSAGES TABLE (Staff Internal Messages)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS chat_messages (
    id BIGSERIAL PRIMARY KEY,
    chat_id BIGINT NOT NULL REFERENCES internal_chats(id) ON DELETE CASCADE,
    sender_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    message TEXT NOT NULL,
    is_system BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- ----------------------------------------------------------------------------
-- 30. CHAT IMAGES TABLE (Image Attachments for Internal Chat Messages)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS chat_images (
    id BIGSERIAL PRIMARY KEY,
    message_id BIGINT NOT NULL REFERENCES chat_messages(id) ON DELETE CASCADE,
    image_url TEXT NOT NULL,
    file_name VARCHAR(255),
    file_size INT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);


-- ============================================================================
-- SECTION 2: CORE PLATFORM PERFORMANCE INDEXES
-- ============================================================================

-- Core Platform Indexes
CREATE INDEX IF NOT EXISTS idx_websites_creator ON websites(creator_id);
CREATE INDEX IF NOT EXISTS idx_websites_package ON websites(package_id);
CREATE INDEX IF NOT EXISTS idx_websites_subdomain ON websites(subdomain);
CREATE INDEX IF NOT EXISTS idx_websites_custom_domain ON websites(custom_domain);
CREATE INDEX IF NOT EXISTS idx_purchases_creator ON purchases(creator_id);
CREATE INDEX IF NOT EXISTS idx_purchases_website ON purchases(website_id);
CREATE INDEX IF NOT EXISTS idx_payments_purchase ON payments(purchase_id);
CREATE INDEX IF NOT EXISTS idx_wishlists_creator ON wishlists(creator_id);
CREATE INDEX IF NOT EXISTS idx_wishlists_package ON wishlists(package_id);
CREATE INDEX IF NOT EXISTS idx_subscriptions_creator ON subscriptions(creator_id);
CREATE INDEX IF NOT EXISTS idx_subscriptions_website ON subscriptions(website_id);
CREATE INDEX IF NOT EXISTS idx_subscriptions_package ON subscriptions(package_id);
CREATE INDEX IF NOT EXISTS idx_subscriptions_status ON subscriptions(status);
CREATE INDEX IF NOT EXISTS idx_supports_creator ON supports(creator_id);
CREATE INDEX IF NOT EXISTS idx_supports_website ON supports(website_id);
CREATE INDEX IF NOT EXISTS idx_support_messages_support ON support_messages(support_id);
CREATE INDEX IF NOT EXISTS idx_support_images_message ON support_images(message_id);
CREATE INDEX IF NOT EXISTS idx_blogs_slug ON blogs(slug);
CREATE INDEX IF NOT EXISTS idx_dev_login_activities_dev ON developer_login_activities(developer_id);
CREATE INDEX IF NOT EXISTS idx_dev_login_sessions_dev ON developer_login_sessions(developer_id);
CREATE INDEX IF NOT EXISTS idx_dev_login_sessions_token ON developer_login_sessions(token);
CREATE INDEX IF NOT EXISTS idx_creator_login_sessions_creator ON creator_login_sessions(creator_id);
CREATE INDEX IF NOT EXISTS idx_creator_login_sessions_token ON creator_login_sessions(token);
CREATE INDEX IF NOT EXISTS idx_creator_login_sessions_active ON creator_login_sessions(is_active);
CREATE INDEX IF NOT EXISTS idx_live_chats_session ON live_chats(session_id);
CREATE INDEX IF NOT EXISTS idx_live_chats_creator ON live_chats(creator_id);
CREATE INDEX IF NOT EXISTS idx_live_chats_developer ON live_chats(assigned_developer_id);
CREATE INDEX IF NOT EXISTS idx_live_chats_website ON live_chats(website_id);
CREATE INDEX IF NOT EXISTS idx_live_chats_status ON live_chats(status);
CREATE INDEX IF NOT EXISTS idx_live_chat_messages_chat ON live_chat_messages(chat_id);
CREATE INDEX IF NOT EXISTS idx_internal_chats_creator ON internal_chats(created_by_developer_id);
CREATE INDEX IF NOT EXISTS idx_chat_participants_chat ON chat_participants(chat_id);
CREATE INDEX IF NOT EXISTS idx_chat_participants_dev ON chat_participants(developer_id);
CREATE INDEX IF NOT EXISTS idx_chat_messages_chat ON chat_messages(chat_id);
CREATE INDEX IF NOT EXISTS idx_chat_messages_sender ON chat_messages(sender_developer_id);
CREATE INDEX IF NOT EXISTS idx_chat_images_message ON chat_images(message_id);

-- ----------------------------------------------------------------------------
-- 31. META CONVERSATIONS TABLE (Facebook, Instagram & WhatsApp Threads)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS meta_conversations (
    id BIGSERIAL PRIMARY KEY,
    platform VARCHAR(50) NOT NULL CHECK (platform IN ('facebook', 'instagram', 'whatsapp')),
    external_conversation_id VARCHAR(255) NOT NULL,
    recipient_id VARCHAR(255) NOT NULL,
    recipient_name VARCHAR(255) DEFAULT 'Customer',
    recipient_phone VARCHAR(50),
    recipient_avatar TEXT,
    last_message TEXT,
    last_message_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    status VARCHAR(50) NOT NULL DEFAULT 'OPEN' CHECK (status IN ('OPEN', 'RESOLVED', 'SPAM')),
    unread_count INT NOT NULL DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(platform, external_conversation_id)
);

DROP TRIGGER IF EXISTS update_meta_conversations_updated_at ON meta_conversations;
CREATE TRIGGER update_meta_conversations_updated_at
    BEFORE UPDATE ON meta_conversations
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 32. META MESSAGES TABLE (Facebook, Instagram & WhatsApp Messages & Replies)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS meta_messages (
    id BIGSERIAL PRIMARY KEY,
    conversation_id BIGINT NOT NULL REFERENCES meta_conversations(id) ON DELETE CASCADE,
    platform VARCHAR(50) NOT NULL CHECK (platform IN ('facebook', 'instagram', 'whatsapp')),
    sender_type VARCHAR(50) NOT NULL CHECK (sender_type IN ('CUSTOMER', 'STAFF', 'SYSTEM', 'customer', 'staff', 'system')),
    sender_id VARCHAR(255),
    sender_name VARCHAR(255),
    message_text TEXT NOT NULL,
    media_url TEXT,
    media_type VARCHAR(50),
    external_message_id VARCHAR(255),
    delivery_status VARCHAR(50) DEFAULT 'SENT' CHECK (delivery_status IN ('SENDING', 'SENT', 'DELIVERED', 'READ', 'FAILED', 'sending', 'sent', 'delivered', 'read', 'failed')),
    error_message TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- Platform alias views
CREATE OR REPLACE VIEW facebook_messages AS SELECT * FROM meta_messages WHERE platform = 'facebook';
CREATE OR REPLACE VIEW instagram_messages AS SELECT * FROM meta_messages WHERE platform = 'instagram';
CREATE OR REPLACE VIEW whatsapp_messages AS SELECT * FROM meta_messages WHERE platform = 'whatsapp';

-- Meta performance indexes
CREATE INDEX IF NOT EXISTS idx_meta_conversations_platform ON meta_conversations(platform);
CREATE INDEX IF NOT EXISTS idx_meta_conversations_status ON meta_conversations(status);
CREATE INDEX IF NOT EXISTS idx_meta_conversations_ext_id ON meta_conversations(external_conversation_id);
CREATE INDEX IF NOT EXISTS idx_meta_conversations_updated ON meta_conversations(updated_at DESC);
CREATE INDEX IF NOT EXISTS idx_meta_messages_conv ON meta_messages(conversation_id);
CREATE INDEX IF NOT EXISTS idx_meta_messages_platform ON meta_messages(platform);
CREATE INDEX IF NOT EXISTS idx_meta_messages_created ON meta_messages(created_at ASC);

