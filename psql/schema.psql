-- ============================================================================
-- SAAS EDUCATIONAL WEBSITE DEVELOPER COMPANY PLATFORM
-- Multi-Tenant Database Architecture & Schema Definition
-- Main SaaS Platform & Company Operations Schema
-- ============================================================================

-- Enable required extensions
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- ============================================================================
-- GLOBAL UTILITY FUNCTIONS & TRIGGERS
-- ============================================================================

-- Function to automatically update updated_at timestamp on row modification
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;


-- ============================================================================
-- SECTION 1: MAIN SAAS COMPANY / PLATFORM TABLES
-- (Super-Admin, Developers, Role Permissions, Packages, Modules, Billing, Support & FAQs)
-- ============================================================================

-- ----------------------------------------------------------------------------
-- 1. MODULES TABLE (Main SaaS Website System Modules for Platform & Developer Panels)
-- Records developer panels pages and their corresponding APIs
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS modules (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(100) UNIQUE NOT NULL,
    slug VARCHAR(100) UNIQUE NOT NULL,
    page_path VARCHAR(255) NOT NULL DEFAULT '/developer',
    api_path VARCHAR(255) DEFAULT '/api/marketing/developer',
    description TEXT,
    icon VARCHAR(100) DEFAULT 'BiGridAlt',
    is_active BOOLEAN DEFAULT TRUE,
    sort_order INT DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- Idempotent column migrations for existing modules table
ALTER TABLE modules ADD COLUMN IF NOT EXISTS page_path VARCHAR(255) NOT NULL DEFAULT '/developer';
ALTER TABLE modules ADD COLUMN IF NOT EXISTS api_path VARCHAR(255) DEFAULT '/api/marketing/developer';
ALTER TABLE modules ADD COLUMN IF NOT EXISTS icon VARCHAR(100) DEFAULT 'BiGridAlt';
ALTER TABLE modules ADD COLUMN IF NOT EXISTS sort_order INT DEFAULT 0;

DROP TRIGGER IF EXISTS update_modules_updated_at ON modules;
CREATE TRIGGER update_modules_updated_at
    BEFORE UPDATE ON modules
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 2. DEVELOPER ROLES TABLE (Role-Based Access Control for Platform Engineering)
-- e.g., Super Admin, Lead Developer, Support Specialist, Content Manager
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS developer_roles (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(100) UNIQUE NOT NULL,
    slug VARCHAR(100) UNIQUE NOT NULL,
    description TEXT,
    is_system BOOLEAN DEFAULT FALSE,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_developer_roles_updated_at ON developer_roles;
CREATE TRIGGER update_developer_roles_updated_at
    BEFORE UPDATE ON developer_roles
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 3. 
TABLE (SaaS Company Engineers, Admins & Staff)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS developers (
    id BIGSERIAL PRIMARY KEY,
    role_id BIGINT REFERENCES developer_roles(id) ON DELETE SET NULL,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) UNIQUE NOT NULL,
    phone VARCHAR(50) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,
    bio TEXT,
    github_profile VARCHAR(255),
    linkedin_profile VARCHAR(255),
    is_active BOOLEAN DEFAULT TRUE,
    email_verified BOOLEAN DEFAULT FALSE,
    verification_token VARCHAR(255),
    verification_token_expires TIMESTAMPTZ,
    two_factor_code VARCHAR(10),
    two_factor_expires TIMESTAMPTZ,
    two_factor_enabled BOOLEAN DEFAULT FALSE,
    failed_login_attempts INT DEFAULT 0,
    locked_until TIMESTAMPTZ,
    recovery_token VARCHAR(255),
    recovery_token_expires TIMESTAMPTZ,
    last_login_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX IF NOT EXISTS idx_developers_phone ON developers(phone);

ALTER TABLE developers ADD COLUMN IF NOT EXISTS role_id BIGINT REFERENCES developer_roles(id) ON DELETE SET NULL;

CREATE INDEX IF NOT EXISTS idx_developers_role ON developers(role_id);

DROP TRIGGER IF EXISTS update_developers_updated_at ON developers;
CREATE TRIGGER update_developers_updated_at
    BEFORE UPDATE ON developers
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 4. DEVELOPER ROLE PERMISSIONS TABLE (Granular Access Controls by Role)
-- Maps developer_roles to modules with view, create, edit, delete privileges
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS developer_role_permissions (
    id BIGSERIAL PRIMARY KEY,
    role_id BIGINT NOT NULL REFERENCES developer_roles(id) ON DELETE CASCADE,
    module_id BIGINT NOT NULL REFERENCES modules(id) ON DELETE CASCADE,
    can_view BOOLEAN DEFAULT TRUE,
    can_create BOOLEAN DEFAULT FALSE,
    can_edit BOOLEAN DEFAULT FALSE,
    can_delete BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(role_id, module_id)
);

CREATE INDEX IF NOT EXISTS idx_dev_role_perms_role ON developer_role_permissions(role_id);
CREATE INDEX IF NOT EXISTS idx_dev_role_perms_mod ON developer_role_permissions(module_id);

DROP TRIGGER IF EXISTS update_developer_role_permissions_updated_at ON developer_role_permissions;
CREATE TRIGGER update_developer_role_permissions_updated_at
    BEFORE UPDATE ON developer_role_permissions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- Compatibility view / table for legacy module_permissions query
DO $$
BEGIN
    IF EXISTS (
        SELECT 1 FROM information_schema.tables 
        WHERE table_schema = 'public' AND table_name = 'module_permissions' AND table_type = 'BASE TABLE'
    ) THEN
        DROP TABLE module_permissions CASCADE;
    END IF;
END $$;

CREATE OR REPLACE VIEW module_permissions AS
SELECT 
    drp.id,
    d.id AS developer_id,
    drp.module_id,
    drp.can_view,
    drp.can_create,
    drp.can_edit,
    drp.can_delete,
    drp.created_at,
    drp.updated_at
FROM developers d
JOIN developer_role_permissions drp ON d.role_id = drp.role_id;

-- ----------------------------------------------------------------------------
-- 6. DEVELOPER LOGIN ACTIVITIES TABLE (Developer Login Audit Trail)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS developer_login_activities (
    id BIGSERIAL PRIMARY KEY,
    developer_id BIGINT NOT NULL REFERENCES developers(id) ON DELETE CASCADE,
    ip_address VARCHAR(100),
    user_agent TEXT,
    status VARCHAR(50) NOT NULL DEFAULT 'Success' CHECK (status IN ('Success', 'Failed')),
    failure_reason VARCHAR(255),
    login_time TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- ----------------------------------------------------------------------------
-- 7. DEVELOPER LOGIN SESSIONS TABLE (Active Developer Auth Sessions)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS developer_login_sessions (
    id BIGSERIAL PRIMARY KEY,
    developer_id BIGINT NOT NULL REFERENCES developers(id) ON DELETE CASCADE,
    token TEXT UNIQUE NOT NULL,
    ip_address VARCHAR(100),
    user_agent TEXT,
    expires_at TIMESTAMPTZ NOT NULL,
    is_active BOOLEAN DEFAULT TRUE,
    last_active_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_developer_login_sessions_updated_at ON developer_login_sessions;
CREATE TRIGGER update_developer_login_sessions_updated_at
    BEFORE UPDATE ON developer_login_sessions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 7B. DEVELOPER ACTIVITY LOGS TABLE (Every Developer POST/PUT/PATCH/DELETE)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS developer_activity_logs (
    id BIGSERIAL PRIMARY KEY,
    developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    developer_name VARCHAR(255),
    developer_email VARCHAR(255),
    role_name VARCHAR(150),
    method VARCHAR(10) NOT NULL CHECK (method IN ('POST', 'PUT', 'PATCH', 'DELETE')),
    module VARCHAR(120) NOT NULL,
    action VARCHAR(150) NOT NULL,
    endpoint TEXT NOT NULL,
    target_id VARCHAR(120),
    ip_address VARCHAR(100),
    user_agent TEXT,
    details JSONB DEFAULT '{}'::jsonb,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_dev_activity_logs_dev ON developer_activity_logs(developer_id);
CREATE INDEX IF NOT EXISTS idx_dev_activity_logs_module ON developer_activity_logs(module);
CREATE INDEX IF NOT EXISTS idx_dev_activity_logs_created ON developer_activity_logs(created_at DESC);

-- ----------------------------------------------------------------------------
-- 8. PACKAGES TABLE (Subscription Pricing Plans for Schools/Clients)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS packages (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(100) UNIQUE NOT NULL,
    slug VARCHAR(100) UNIQUE NOT NULL,
    short_description TEXT,
    description TEXT,
    tagline VARCHAR(255),
    bdt_per_month DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (bdt_per_month >= 0.00),
    usd_per_month DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (usd_per_month >= 0.00),
    eur_per_month DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (eur_per_month >= 0.00),
    gbp_per_month DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (gbp_per_month >= 0.00),
    aud_per_month DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (aud_per_month >= 0.00),
    cad_per_month DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (cad_per_month >= 0.00),
    discount_percentage DECIMAL(5, 2) DEFAULT 0.00 CHECK (discount_percentage >= 0.00 AND discount_percentage <= 100.00),
    max_students INT DEFAULT 500,
    max_teachers INT DEFAULT 30,
    max_staff INT DEFAULT 20,
    max_storage_mb BIGINT DEFAULT 5120,
    is_available_student_panel BOOLEAN DEFAULT TRUE,
    is_available_teacher_panel BOOLEAN DEFAULT TRUE,
    is_available_custom_domain BOOLEAN DEFAULT FALSE,
    features JSONB DEFAULT '[]'::jsonb,
    is_popular BOOLEAN DEFAULT FALSE,
    is_public BOOLEAN DEFAULT TRUE,
    is_active BOOLEAN DEFAULT TRUE,
    grace_period INT DEFAULT 3,
    sort_order INT DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- Idempotent column migrations for existing packages table
ALTER TABLE packages DROP COLUMN IF EXISTS max_websites;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS short_description TEXT;
ALTER TABLE packages DROP COLUMN IF EXISTS max_storage CASCADE;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS max_storage_mb BIGINT DEFAULT 5120;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS is_available_student_panel BOOLEAN DEFAULT TRUE;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS is_available_teacher_panel BOOLEAN DEFAULT TRUE;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS is_available_custom_domain BOOLEAN DEFAULT FALSE;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS bdt_per_month DECIMAL(12, 2) NOT NULL DEFAULT 0.00;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS usd_per_month DECIMAL(12, 2) NOT NULL DEFAULT 0.00;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS eur_per_month DECIMAL(12, 2) NOT NULL DEFAULT 0.00;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS gbp_per_month DECIMAL(12, 2) NOT NULL DEFAULT 0.00;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS aud_per_month DECIMAL(12, 2) NOT NULL DEFAULT 0.00;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS cad_per_month DECIMAL(12, 2) NOT NULL DEFAULT 0.00;
ALTER TABLE packages DROP COLUMN IF EXISTS monthly_price_usd;
ALTER TABLE packages DROP COLUMN IF EXISTS yearly_price_usd;
ALTER TABLE packages DROP COLUMN IF EXISTS monthly_price_bdt;
ALTER TABLE packages DROP COLUMN IF EXISTS yearly_price_bdt;
ALTER TABLE packages DROP COLUMN IF EXISTS monthly_price;
ALTER TABLE packages DROP COLUMN IF EXISTS yearly_price;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS is_public BOOLEAN DEFAULT TRUE;
ALTER TABLE packages ADD COLUMN IF NOT EXISTS grace_period INT DEFAULT 3;
ALTER TABLE packages DROP COLUMN IF EXISTS monthly_mail CASCADE;
ALTER TABLE packages DROP COLUMN IF EXISTS monthly_sms CASCADE;
ALTER TABLE packages DROP COLUMN IF EXISTS charge_model CASCADE;
ALTER TABLE packages DROP COLUMN IF EXISTS per_tx_fee_type CASCADE;
ALTER TABLE packages DROP COLUMN IF EXISTS per_tx_fee_value CASCADE;
ALTER TABLE packages DROP COLUMN IF EXISTS per_student_fee_usd CASCADE;
ALTER TABLE packages DROP COLUMN IF EXISTS per_student_fee_bdt CASCADE;
ALTER TABLE packages DROP COLUMN IF EXISTS student_fee_cycle_days CASCADE;
ALTER TABLE packages DROP COLUMN IF EXISTS trial_days;

CREATE INDEX IF NOT EXISTS idx_packages_public ON packages(is_public, is_active, sort_order);

DROP TRIGGER IF EXISTS update_packages_updated_at ON packages;
CREATE TRIGGER update_packages_updated_at
    BEFORE UPDATE ON packages
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 8B. PACKAGE FEATURES TABLE (Showcase Informational Features per Package)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS package_features (
    id BIGSERIAL PRIMARY KEY,
    package_id BIGINT NOT NULL REFERENCES packages(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    slug VARCHAR(160) NOT NULL,
    display_order INT DEFAULT 0,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(package_id, slug)
);

CREATE INDEX IF NOT EXISTS idx_package_features_pkg ON package_features(package_id, display_order);

DROP TRIGGER IF EXISTS update_package_features_updated_at ON package_features;
CREATE TRIGGER update_package_features_updated_at
    BEFORE UPDATE ON package_features
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- Deprecated website_modules table removed (superseded by website_home_modules and website_control_modules)
-- ----------------------------------------------------------------------------
DROP TABLE IF EXISTS website_modules CASCADE;

-- ----------------------------------------------------------------------------
-- 9B. WEBSITE HOME MODULES TABLE (Public Institutional Website Pages & Features)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_home_modules (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(150) NOT NULL,
    slug VARCHAR(100) UNIQUE NOT NULL,
    path VARCHAR(255) NOT NULL,
    category VARCHAR(100) DEFAULT 'General',
    description TEXT,
    icon VARCHAR(100),
    is_active BOOLEAN DEFAULT TRUE,
    display_order INT DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_schema_home_modules_slug ON website_home_modules(slug);

DROP TRIGGER IF EXISTS update_website_home_modules_updated_at ON website_home_modules;
CREATE TRIGGER update_website_home_modules_updated_at
    BEFORE UPDATE ON website_home_modules
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 9C. WEBSITE CONTROL MODULES TABLE (Administrative Staff Panel & Portal Workstations)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS website_control_modules (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(150) NOT NULL,
    slug VARCHAR(100) UNIQUE NOT NULL,
    path VARCHAR(255) NOT NULL,
    category VARCHAR(100) DEFAULT 'General Management',
    description TEXT,
    icon VARCHAR(100),
    is_active BOOLEAN DEFAULT TRUE,
    display_order INT DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_schema_control_modules_slug ON website_control_modules(slug);

DROP TRIGGER IF EXISTS update_website_control_modules_updated_at ON website_control_modules;
CREATE TRIGGER update_website_control_modules_updated_at
    BEFORE UPDATE ON website_control_modules
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 10. REMOVE OBSOLETE PACKAGE_MODULES TABLE & CREATE SEPARATE TWO NEW
-- ----------------------------------------------------------------------------
DROP VIEW IF EXISTS package_website_modules CASCADE;
DROP TABLE IF EXISTS package_modules CASCADE;

-- 10A. PACKAGE HOME MODULES TABLE (Connects Package with Public Website Home Modules)
CREATE TABLE IF NOT EXISTS package_home_modules (
    id BIGSERIAL PRIMARY KEY,
    package_id BIGINT NOT NULL REFERENCES packages(id) ON DELETE CASCADE,
    home_module_id BIGINT NOT NULL REFERENCES website_home_modules(id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(package_id, home_module_id)
);

CREATE INDEX IF NOT EXISTS idx_pkg_home_mods_pkg ON package_home_modules(package_id);
CREATE INDEX IF NOT EXISTS idx_pkg_home_mods_mod ON package_home_modules(home_module_id);

-- 10B. PACKAGE CONTROL MODULES TABLE (Connects Package with Staff Workstation Control Modules)
CREATE TABLE IF NOT EXISTS package_control_modules (
    id BIGSERIAL PRIMARY KEY,
    package_id BIGINT NOT NULL REFERENCES packages(id) ON DELETE CASCADE,
    control_module_id BIGINT NOT NULL REFERENCES website_control_modules(id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(package_id, control_module_id)
);

CREATE INDEX IF NOT EXISTS idx_pkg_ctrl_mods_pkg ON package_control_modules(package_id);
CREATE INDEX IF NOT EXISTS idx_pkg_ctrl_mods_mod ON package_control_modules(control_module_id);

INSERT INTO website_control_modules (name, slug, path, category, description, icon, is_active, display_order)
VALUES (
    'System & Architecture',
    'system',
    '/staff-panel/system',
    'Staff & System Settings',
    'Institutional profile, domain routing, academic hierarchy presets, appearance, and direct portals',
    'BiServer',
    TRUE,
    204
)
ON CONFLICT (slug) DO UPDATE SET
    name = EXCLUDED.name,
    path = EXCLUDED.path,
    category = EXCLUDED.category,
    description = EXCLUDED.description,
    icon = EXCLUDED.icon,
    is_active = TRUE;

INSERT INTO package_control_modules (package_id, control_module_id)
SELECT p.id, cm.id
FROM packages p
CROSS JOIN website_control_modules cm
WHERE cm.slug = 'system'
ON CONFLICT (package_id, control_module_id) DO NOTHING;

INSERT INTO website_control_modules (name, slug, path, category, description, icon, is_active, display_order)
VALUES
    ('SMS Balance', 'sms-balance', '/staff-panel/sms-balance', 'Communications & Gateways', 'Monitor monthly SMS quota usage, delivery logs, and recipient analytics', 'BiMessageDetail', TRUE, 205),
    ('Mail Balance', 'mail-balance', '/staff-panel/mail-balance', 'Communications & Gateways', 'Track transactional and institutional email dispatches and quota usage', 'BiEnvelope', TRUE, 206),
    ('Transactions & Accounts', 'transactions', '/staff-panel/transactions', 'Fees & Accounting', 'Inspect payment gateway settlements, merchant accounts, and fee transactions', 'BiTransfer', TRUE, 207)
ON CONFLICT (slug) DO UPDATE SET
    name = EXCLUDED.name,
    path = EXCLUDED.path,
    category = EXCLUDED.category,
    description = EXCLUDED.description,
    icon = EXCLUDED.icon,
    is_active = TRUE;

INSERT INTO package_control_modules (package_id, control_module_id)
SELECT DISTINCT pcm.package_id, cm.id
FROM package_control_modules pcm
JOIN website_control_modules ref ON ref.id = pcm.control_module_id AND ref.slug = 'contacts'
JOIN website_control_modules cm ON cm.slug IN ('sms-balance', 'mail-balance')
ON CONFLICT (package_id, control_module_id) DO NOTHING;

INSERT INTO package_control_modules (package_id, control_module_id)
SELECT DISTINCT pcm.package_id, cm.id
FROM package_control_modules pcm
JOIN website_control_modules ref ON ref.id = pcm.control_module_id AND ref.slug = 'fees-education-configure'
JOIN website_control_modules cm ON cm.slug = 'transactions'
ON CONFLICT (package_id, control_module_id) DO NOTHING;

-- ----------------------------------------------------------------------------
-- 11. CREATORS TABLE (Clients / Educational Institution Owners / Customers)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS creators (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) UNIQUE NOT NULL,
    phone VARCHAR(50) UNIQUE NOT NULL,
    country VARCHAR(100),
    city VARCHAR(100),
    address TEXT,
    password VARCHAR(255) NOT NULL,
    email_verified BOOLEAN DEFAULT FALSE,
    verification_token VARCHAR(255),
    verification_token_expires TIMESTAMPTZ,
    recovery_token VARCHAR(255),
    recovery_token_expires TIMESTAMPTZ,
    two_factor_code VARCHAR(10),
    two_factor_expires TIMESTAMPTZ,
    two_factor_enabled BOOLEAN DEFAULT FALSE,
    failed_login_attempts INT DEFAULT 0,
    locked_until TIMESTAMPTZ,
    is_active BOOLEAN DEFAULT TRUE,
    last_login_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);
CREATE UNIQUE INDEX IF NOT EXISTS idx_creators_phone ON creators(phone);
CREATE INDEX IF NOT EXISTS idx_creators_email ON creators(email);

DROP TRIGGER IF EXISTS update_creators_updated_at ON creators;
CREATE TRIGGER update_creators_updated_at
    BEFORE UPDATE ON creators
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 11B. CREATOR LOGIN SESSIONS TABLE (Active Creator Auth Sessions)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS creator_login_sessions (
    id BIGSERIAL PRIMARY KEY,
    creator_id BIGINT NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    token TEXT UNIQUE NOT NULL,
    ip_address VARCHAR(100),
    user_agent TEXT,
    expires_at TIMESTAMPTZ NOT NULL,
    is_active BOOLEAN DEFAULT TRUE,
    last_active_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE OR REPLACE VIEW creator_login_session AS SELECT * FROM creator_login_sessions;

DROP TRIGGER IF EXISTS update_creator_login_sessions_updated_at ON creator_login_sessions;
CREATE TRIGGER update_creator_login_sessions_updated_at
    BEFORE UPDATE ON creator_login_sessions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

CREATE TABLE IF NOT EXISTS creator_login_activities (
    id BIGSERIAL PRIMARY KEY,
    creator_id BIGINT REFERENCES creators(id) ON DELETE CASCADE,
    ip_address VARCHAR(100),
    user_agent TEXT,
    status VARCHAR(50) DEFAULT 'Success',
    failure_reason VARCHAR(255),
    login_time TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_creator_login_activities_creator_id ON creator_login_activities(creator_id);
CREATE INDEX IF NOT EXISTS idx_creator_login_activities_ip ON creator_login_activities(ip_address);

CREATE TABLE IF NOT EXISTS security_rate_limits (
    id BIGSERIAL PRIMARY KEY,
    rate_key VARCHAR(255) NOT NULL UNIQUE,
    hit_count INT DEFAULT 1,
    window_start TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    blocked_until TIMESTAMPTZ DEFAULT NULL,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_security_rate_limits_key ON security_rate_limits(rate_key);

CREATE TABLE IF NOT EXISTS security_attack_logs (
    id BIGSERIAL PRIMARY KEY,
    ip_address VARCHAR(100) NOT NULL,
    user_agent TEXT,
    endpoint VARCHAR(255),
    attack_type VARCHAR(100) NOT NULL,
    severity VARCHAR(50) DEFAULT 'MEDIUM',
    payload_sample TEXT,
    blocked_until TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_security_attack_logs_ip ON security_attack_logs(ip_address);
CREATE INDEX IF NOT EXISTS idx_security_attack_logs_created ON security_attack_logs(created_at);

CREATE TABLE IF NOT EXISTS sms_logs (
    id BIGSERIAL PRIMARY KEY,
    recipient VARCHAR(50) NOT NULL,
    user_type VARCHAR(50) DEFAULT 'system',
    user_id BIGINT,
    purpose VARCHAR(50) NOT NULL,
    channel VARCHAR(20) DEFAULT 'sms',
    provider VARCHAR(50) DEFAULT 'zendsms',
    sender_id VARCHAR(50),
    message TEXT NOT NULL,
    status VARCHAR(50) NOT NULL,
    response_code VARCHAR(50),
    response_body JSONB,
    ip_address VARCHAR(100),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_sms_logs_recipient ON sms_logs(recipient);
CREATE INDEX IF NOT EXISTS idx_sms_logs_created ON sms_logs(created_at);

CREATE TABLE IF NOT EXISTS email_logs (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT REFERENCES websites(id) ON DELETE SET NULL,
    recipient VARCHAR(255) NOT NULL,
    recipient_name VARCHAR(255),
    user_type VARCHAR(50) DEFAULT 'system',
    user_id BIGINT,
    purpose VARCHAR(100) NOT NULL,
    subject VARCHAR(500) NOT NULL,
    content TEXT,
    channel VARCHAR(20) DEFAULT 'email',
    provider VARCHAR(50) DEFAULT 'brevo',
    sender_email VARCHAR(255),
    sender_name VARCHAR(255),
    status VARCHAR(50) NOT NULL DEFAULT 'Sent',
    message_id VARCHAR(255),
    failure_reason TEXT,
    ip_address VARCHAR(100),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_email_logs_recipient ON email_logs(recipient);
CREATE INDEX IF NOT EXISTS idx_email_logs_created ON email_logs(created_at);
CREATE INDEX IF NOT EXISTS idx_email_logs_website ON email_logs(website_id);

CREATE TABLE IF NOT EXISTS custom_emails (
    id BIGSERIAL PRIMARY KEY,
    to_email VARCHAR(255) NOT NULL,
    subject VARCHAR(500) NOT NULL,
    description TEXT NOT NULL,
    attachments JSONB DEFAULT '[]'::jsonb,
    status VARCHAR(50) NOT NULL DEFAULT 'Sent',
    provider VARCHAR(50) DEFAULT 'brevo',
    message_id VARCHAR(255),
    failure_reason TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_custom_emails_to ON custom_emails(to_email);
CREATE INDEX IF NOT EXISTS idx_custom_emails_created ON custom_emails(created_at DESC);

DROP TRIGGER IF EXISTS update_custom_emails_updated_at ON custom_emails;
CREATE TRIGGER update_custom_emails_updated_at
    BEFORE UPDATE ON custom_emails
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

CREATE TABLE IF NOT EXISTS otp_dispatch_logs (
    id BIGSERIAL PRIMARY KEY,
    identifier VARCHAR(255) NOT NULL,
    phone VARCHAR(50),
    email VARCHAR(255),
    channel VARCHAR(20) NOT NULL,
    purpose VARCHAR(50) NOT NULL,
    ip_address VARCHAR(100),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_otp_logs_ident_created ON otp_dispatch_logs(identifier, created_at);
CREATE INDEX IF NOT EXISTS idx_otp_logs_email_created ON otp_dispatch_logs(email, created_at);
CREATE INDEX IF NOT EXISTS idx_otp_logs_phone_created ON otp_dispatch_logs(phone, created_at);
CREATE INDEX IF NOT EXISTS idx_otp_logs_ip_created ON otp_dispatch_logs(ip_address, created_at);

CREATE TABLE IF NOT EXISTS contact_update_verifications (
    id BIGSERIAL PRIMARY KEY,
    user_type VARCHAR(20) NOT NULL CHECK (user_type IN ('developer', 'creator')),
    user_id BIGINT NOT NULL,
    new_email VARCHAR(255),
    new_phone VARCHAR(50),
    otp_code VARCHAR(10) NOT NULL,
    expires_at TIMESTAMPTZ NOT NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_contact_update_user ON contact_update_verifications(user_type, user_id);

-- ----------------------------------------------------------------------------
-- 12. SUBSCRIBERS TABLE (Marketing & Newsletter Subscribers)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS subscribers (
    id BIGSERIAL PRIMARY KEY,
    email VARCHAR(255) UNIQUE NOT NULL,
    name VARCHAR(255),
    source VARCHAR(100) DEFAULT 'website',
    is_active BOOLEAN DEFAULT TRUE,
    subscribed_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    unsubscribed_at TIMESTAMPTZ
);

-- ----------------------------------------------------------------------------
-- 13. WEBSITES TABLE (TENANTS MASTER TABLE)
-- Represents individual educational institution websites hosted on SaaS
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS websites (
    id BIGSERIAL PRIMARY KEY,
    creator_id BIGINT NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    subscription_id BIGINT,
    name VARCHAR(255) NOT NULL,
    slug VARCHAR(100) UNIQUE NOT NULL,
    institution_type VARCHAR(100) DEFAULT 'School',
    eiin_number VARCHAR(100),
    status VARCHAR(50) NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'pending', 'suspended', 'expired', 'archived')),
    theme VARCHAR(100) DEFAULT 'default',
    primary_color VARCHAR(50) DEFAULT '#1e40af',
    secondary_color VARCHAR(50) DEFAULT '#0ea5e9',
    logo TEXT,
    logo_id VARCHAR(255),
    favicon TEXT,
    favicon_id VARCHAR(255),
    contact_email VARCHAR(255),
    contact_phone VARCHAR(50),
    address TEXT,
    facebook_url TEXT,
    twitter_url TEXT,
    instagram_url TEXT,
    youtube_url TEXT,
    linkedin_url TEXT,
    currency VARCHAR(10) NOT NULL DEFAULT 'BDT',
    subscription_expires_at TIMESTAMPTZ,
    storage_used_mb INT DEFAULT 0,
    is_maintenance_mode BOOLEAN DEFAULT FALSE,
    maintenance_message TEXT DEFAULT 'Our campus portal is temporarily under scheduled maintenance. Please check back shortly.',
    deletion_requested_at TIMESTAMPTZ,
    deletion_scheduled_at TIMESTAMPTZ,
    deletion_requested_by VARCHAR(50),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

ALTER TABLE websites ADD COLUMN IF NOT EXISTS deletion_requested_at TIMESTAMPTZ;
ALTER TABLE websites ADD COLUMN IF NOT EXISTS deletion_scheduled_at TIMESTAMPTZ;
ALTER TABLE websites ADD COLUMN IF NOT EXISTS deletion_requested_by VARCHAR(50);
CREATE INDEX IF NOT EXISTS idx_websites_deletion_scheduled ON websites(deletion_scheduled_at) WHERE deletion_scheduled_at IS NOT NULL;

ALTER TABLE websites DROP COLUMN IF EXISTS subdomain CASCADE;
ALTER TABLE websites DROP COLUMN IF EXISTS custom_domain CASCADE;
ALTER TABLE websites DROP COLUMN IF EXISTS custom_domain_verified CASCADE;

CREATE TABLE IF NOT EXISTS website_domains (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    domain_type VARCHAR(50) DEFAULT 'subdomain' CHECK (domain_type IN ('subdomain', 'custom_domain', 'custom')),
    domain VARCHAR(255) NOT NULL UNIQUE,
    domain_name VARCHAR(255),
    is_primary BOOLEAN DEFAULT FALSE,
    is_verified BOOLEAN DEFAULT FALSE,
    verification_token VARCHAR(255),
    dns_record_type VARCHAR(10) DEFAULT 'CNAME',
    dns_record_value VARCHAR(255) DEFAULT 'domains.hiesci.com',
    dns_records JSONB DEFAULT '[]'::jsonb,
    ssl_status VARCHAR(50) DEFAULT 'pending',
    verified_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_website_domains_website ON website_domains(website_id);
CREATE INDEX IF NOT EXISTS idx_website_domains_domain ON website_domains(domain);

DROP TRIGGER IF EXISTS update_website_domains_updated_at ON website_domains;
CREATE TRIGGER update_website_domains_updated_at
    BEFORE UPDATE ON website_domains
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

CREATE TABLE IF NOT EXISTS website_information (
    id BIGSERIAL PRIMARY KEY,
    website_id BIGINT UNIQUE NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    creator_nid VARCHAR(100),
    creator_nid_url TEXT,
    creator_nid_front_image TEXT,
    creator_nid_front_image_id VARCHAR(255),
    creator_nid_back_image TEXT,
    creator_nid_back_image_id VARCHAR(255),
    eiin_certificate VARCHAR(100),
    eiin_certificate_url TEXT,
    eiin_certificate_image TEXT,
    eiin_certificate_image_id VARCHAR(255),
    ugc_certificate TEXT,
    ugc_certificate_id VARCHAR(255),
    additional_certificate TEXT,
    additional_certificate_id VARCHAR(255),
    address TEXT,
    other_details JSONB DEFAULT '{}'::jsonb,
    verification_status VARCHAR(50) DEFAULT 'pending' CHECK (verification_status IN ('pending', 'approved', 'rejected')),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

ALTER TABLE website_information ADD COLUMN IF NOT EXISTS creator_nid_front_image TEXT;
ALTER TABLE website_information ADD COLUMN IF NOT EXISTS creator_nid_front_image_id VARCHAR(255);
ALTER TABLE website_information ADD COLUMN IF NOT EXISTS creator_nid_back_image TEXT;
ALTER TABLE website_information ADD COLUMN IF NOT EXISTS creator_nid_back_image_id VARCHAR(255);
ALTER TABLE website_information ADD COLUMN IF NOT EXISTS eiin_certificate_image TEXT;
ALTER TABLE website_information ADD COLUMN IF NOT EXISTS eiin_certificate_image_id VARCHAR(255);
ALTER TABLE website_information ADD COLUMN IF NOT EXISTS ugc_certificate TEXT;
ALTER TABLE website_information ADD COLUMN IF NOT EXISTS ugc_certificate_id VARCHAR(255);
ALTER TABLE website_information ADD COLUMN IF NOT EXISTS additional_certificate TEXT;
ALTER TABLE website_information ADD COLUMN IF NOT EXISTS additional_certificate_id VARCHAR(255);

CREATE INDEX IF NOT EXISTS idx_website_information_website ON website_information(website_id);

DROP TRIGGER IF EXISTS update_website_information_updated_at ON website_information;
CREATE TRIGGER update_website_information_updated_at
    BEFORE UPDATE ON website_information
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

DROP TRIGGER IF EXISTS update_websites_updated_at ON websites;
CREATE TRIGGER update_websites_updated_at
    BEFORE UPDATE ON websites
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();



-- ----------------------------------------------------------------------------
-- 15. PURCHASES TABLE (Package Subscriptions & Module Purchases by Creators)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS currencies (
    id BIGSERIAL PRIMARY KEY,
    code VARCHAR(10) UNIQUE NOT NULL,
    name VARCHAR(100) NOT NULL,
    symbol VARCHAR(10) NOT NULL DEFAULT '',
    is_default BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);
CREATE OR REPLACE VIEW currency AS SELECT * FROM currencies;

CREATE TABLE IF NOT EXISTS promos (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    code VARCHAR(100) UNIQUE NOT NULL,
    description TEXT,
    discount_percentage DECIMAL(5, 2) NOT NULL CHECK (discount_percentage >= 0.00 AND discount_percentage <= 100.00),
    max_uses_per_creator INT NOT NULL DEFAULT 1 CHECK (max_uses_per_creator >= 1),
    max_total_uses INT DEFAULT NULL,
    is_public BOOLEAN NOT NULL DEFAULT FALSE,
    is_active BOOLEAN DEFAULT TRUE,
    start_date TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    ending_date TIMESTAMPTZ NOT NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);
CREATE UNIQUE INDEX IF NOT EXISTS idx_promos_code_upper ON promos (UPPER(code));
CREATE INDEX IF NOT EXISTS idx_promos_public_active ON promos(is_public, is_active);

CREATE TABLE IF NOT EXISTS purchases (
    id BIGSERIAL PRIMARY KEY,
    creator_id BIGINT NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    website_id BIGINT REFERENCES websites(id) ON DELETE CASCADE,
    package_id BIGINT REFERENCES packages(id) ON DELETE SET NULL,
    promo_id BIGINT REFERENCES promos(id) ON DELETE SET NULL,
    purchase_code VARCHAR(100) UNIQUE NOT NULL,
    billing_cycle VARCHAR(50) NOT NULL DEFAULT 'monthly' CHECK (billing_cycle IN ('monthly', 'yearly', 'lifetime', 'custom')),
    currency VARCHAR(10) NOT NULL DEFAULT 'BDT',
    base_amount DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (base_amount >= 0.00),
    discount_amount DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (discount_amount >= 0.00),
    tax_amount DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (tax_amount >= 0.00),
    total_amount DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (total_amount >= 0.00),
    status VARCHAR(50) NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'completed', 'failed', 'refunded', 'cancelled')),
    period_start TIMESTAMPTZ,
    period_end TIMESTAMPTZ,
    invoice_pdf_url TEXT,
    notes TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

ALTER TABLE purchases ADD COLUMN IF NOT EXISTS promo_id BIGINT REFERENCES promos(id) ON DELETE SET NULL;
ALTER TABLE purchases ADD COLUMN IF NOT EXISTS currency VARCHAR(10) NOT NULL DEFAULT 'BDT';

CREATE TABLE IF NOT EXISTS promo_usages (
    id BIGSERIAL PRIMARY KEY,
    promo_id BIGINT NOT NULL REFERENCES promos(id) ON DELETE CASCADE,
    creator_id BIGINT NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    payment_id BIGINT REFERENCES payments(id) ON DELETE CASCADE,
    purchase_id BIGINT REFERENCES purchases(id) ON DELETE SET NULL,
    discount_amount DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (discount_amount >= 0.00),
    used_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_promo_usages_promo_creator ON promo_usages(promo_id, creator_id);

DROP TRIGGER IF EXISTS update_purchases_updated_at ON purchases;
CREATE TRIGGER update_purchases_updated_at
    BEFORE UPDATE ON purchases
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 16. PAYMENTS TABLE (Financial Transactions for SaaS Subscriptions)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS payments (
    id BIGSERIAL PRIMARY KEY,
    purchase_id BIGINT REFERENCES purchases(id) ON DELETE SET NULL,
    creator_id BIGINT NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    package_id BIGINT REFERENCES packages(id) ON DELETE SET NULL,
    promo_id BIGINT REFERENCES promos(id) ON DELETE SET NULL,
    billing_cycle VARCHAR(50) NOT NULL DEFAULT 'monthly' CHECK (billing_cycle IN ('monthly', 'yearly', 'lifetime', 'custom')),
    invoice_no VARCHAR(100),
    transaction_id VARCHAR(100) UNIQUE NOT NULL,
    amount DECIMAL(12, 2) NOT NULL CHECK (amount >= 0.00),
    base_amount DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (base_amount >= 0.00),
    discount_amount DECIMAL(12, 2) NOT NULL DEFAULT 0.00 CHECK (discount_amount >= 0.00),
    currency VARCHAR(10) NOT NULL DEFAULT 'BDT',
    payment_method VARCHAR(100) NOT NULL DEFAULT 'sslcommerz',
    payment_gateway VARCHAR(100),
    gateway_order_id VARCHAR(150),
    payer_email VARCHAR(150),
    payer_phone VARCHAR(50),
    gateway_fee DECIMAL(10, 2) DEFAULT 0.00 CHECK (gateway_fee >= 0.00),
    net_amount NUMERIC(12, 2),
    gateway_response JSONB,
    processed_by_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    manual_payment_notes TEXT,
    status VARCHAR(50) NOT NULL DEFAULT 'unpaid' CHECK (status IN ('unpaid', 'due', 'pending', 'successful', 'completed', 'failed', 'refunded', 'cancelled')),
    payment_date TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX IF NOT EXISTS idx_tier1_payments_gw_order ON payments(gateway_order_id);

DROP TRIGGER IF EXISTS update_payments_updated_at ON payments;
CREATE TRIGGER update_payments_updated_at
    BEFORE UPDATE ON payments
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

CREATE TABLE IF NOT EXISTS payment_transactions (
    id BIGSERIAL PRIMARY KEY,
    payment_id BIGINT NOT NULL REFERENCES payments(id) ON DELETE CASCADE,
    creator_id BIGINT NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    transaction_id VARCHAR(100) NOT NULL,
    amount DECIMAL(12, 2) NOT NULL CHECK (amount >= 0.00),
    currency VARCHAR(10) NOT NULL DEFAULT 'BDT',
    payment_gateway VARCHAR(100) NOT NULL DEFAULT 'sslcommerz',
    payment_method VARCHAR(100),
    gateway_transaction_id VARCHAR(150),
    gateway_order_id VARCHAR(150),
    bank_tran_id VARCHAR(150),
    card_type VARCHAR(100),
    card_brand VARCHAR(100),
    card_issuer VARCHAR(150),
    gateway_response JSONB,
    processed_by_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    manual_payment_notes TEXT,
    status VARCHAR(50) NOT NULL DEFAULT 'successful' CHECK (status IN ('successful', 'failed', 'refunded', 'cancelled')),
    paid_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);
CREATE OR REPLACE VIEW payment_transaction AS SELECT * FROM payment_transactions;

DROP TRIGGER IF EXISTS update_payment_transactions_updated_at ON payment_transactions;
CREATE TRIGGER update_payment_transactions_updated_at
    BEFORE UPDATE ON payment_transactions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 16.1. WISHLISTS TABLE (Package Wishlists / Saved Plans by Creators)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS wishlists (
    id BIGSERIAL PRIMARY KEY,
    creator_id BIGINT UNIQUE NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    package_id BIGINT NOT NULL REFERENCES packages(id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DO $$ BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM information_schema.table_constraints 
        WHERE constraint_name = 'wishlists_creator_id_key' AND table_name = 'wishlists'
    ) THEN
        ALTER TABLE wishlists DROP CONSTRAINT IF EXISTS wishlists_creator_id_package_id_key;
        ALTER TABLE wishlists ADD CONSTRAINT wishlists_creator_id_key UNIQUE (creator_id);
    END IF;
END $$;

CREATE OR REPLACE VIEW wishlist AS SELECT * FROM wishlists;

DROP TRIGGER IF EXISTS update_wishlists_updated_at ON wishlists;
CREATE TRIGGER update_wishlists_updated_at
    BEFORE UPDATE ON wishlists
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 16.2. SUBSCRIPTIONS TABLE (Active Educational Website Subscriptions)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS subscriptions (
    id BIGSERIAL PRIMARY KEY,
    creator_id BIGINT NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    website_id BIGINT REFERENCES websites(id) ON DELETE CASCADE,
    package_id BIGINT NOT NULL REFERENCES packages(id) ON DELETE CASCADE,
    payment_id BIGINT REFERENCES payments(id) ON DELETE SET NULL,
    purchase_id BIGINT REFERENCES purchases(id) ON DELETE SET NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'inactive', 'suspended', 'trailing', 'past_due', 'cancelled', 'expired')),
    billing_cycle VARCHAR(50) NOT NULL DEFAULT 'monthly' CHECK (billing_cycle IN ('monthly', 'yearly', 'lifetime', 'custom')),
    current_period_start TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    current_period_end TIMESTAMPTZ,
    cancel_at_period_end BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE OR REPLACE VIEW subscription AS SELECT * FROM subscriptions;

DROP TRIGGER IF EXISTS update_subscriptions_updated_at ON subscriptions;
CREATE TRIGGER update_subscriptions_updated_at
    BEFORE UPDATE ON subscriptions
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- Foreign key link connecting websites.subscription_id to subscriptions(id)
DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1 FROM information_schema.table_constraints 
        WHERE constraint_name = 'fk_websites_subscription' AND table_name = 'websites'
    ) THEN
        ALTER TABLE websites 
        ADD CONSTRAINT fk_websites_subscription 
        FOREIGN KEY (subscription_id) REFERENCES subscriptions(id) ON DELETE SET NULL;
    END IF;
END $$;
CREATE INDEX IF NOT EXISTS idx_websites_subscription_id ON websites(subscription_id);

-- ----------------------------------------------------------------------------
-- 17. BLOGS TABLE (SaaS Platform Company Blog & Educational Articles)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS blogs (
    id BIGSERIAL PRIMARY KEY,
    developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    title VARCHAR(255) NOT NULL,
    slug VARCHAR(255) UNIQUE NOT NULL,
    excerpt TEXT,
    content TEXT NOT NULL,
    category VARCHAR(100),
    meta_title VARCHAR(255),
    meta_description TEXT,
    is_published BOOLEAN DEFAULT FALSE,
    published_at TIMESTAMPTZ,
    views_count INT DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_blogs_updated_at ON blogs;
CREATE TRIGGER update_blogs_updated_at
    BEFORE UPDATE ON blogs
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 17.1 BLOG IMAGES TABLE (Gallery & Featured Images for Blogs)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS blog_images (
    id BIGSERIAL PRIMARY KEY,
    blog_id BIGINT NOT NULL REFERENCES blogs(id) ON DELETE CASCADE,
    image TEXT NOT NULL,
    image_id VARCHAR(255),
    caption TEXT,
    is_primary BOOLEAN DEFAULT FALSE,
    display_order INT DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_blog_images_blog_id ON blog_images(blog_id);

-- ----------------------------------------------------------------------------
-- 18. CONTACTS TABLE (Lead Inquiries submitted on Main SaaS Website)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS contacts (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL,
    phone VARCHAR(50),
    institution VARCHAR(255),
    subject VARCHAR(255) NOT NULL,
    message TEXT NOT NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'new' CHECK (status IN ('new', 'read', 'in_progress', 'replied', 'closed')),
    assigned_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    admin_notes TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_contacts_updated_at ON contacts;
CREATE TRIGGER update_contacts_updated_at
    BEFORE UPDATE ON contacts
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 19. REVIEWS TABLE (Client Testimonials & Reviews for SaaS Platform)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS reviews (
    id BIGSERIAL PRIMARY KEY,
    creator_id BIGINT REFERENCES creators(id) ON DELETE SET NULL,
    website_id BIGINT REFERENCES websites(id) ON DELETE CASCADE,
    reviewer_name VARCHAR(255) NOT NULL,
    institution_name VARCHAR(255),
    rating INT NOT NULL CHECK (rating >= 1 AND rating <= 5),
    title VARCHAR(255),
    review_text TEXT NOT NULL,
    is_featured BOOLEAN DEFAULT FALSE,
    is_approved BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_reviews_updated_at ON reviews;
CREATE TRIGGER update_reviews_updated_at
    BEFORE UPDATE ON reviews
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 20. POLICIES TABLE (Platform Legal Documents: Privacy, Terms, SLA, etc.)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS policies (
    id BIGSERIAL PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    slug VARCHAR(255) UNIQUE NOT NULL,
    description TEXT NOT NULL,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_policies_updated_at ON policies;
CREATE TRIGGER update_policies_updated_at
    BEFORE UPDATE ON policies
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 21. FAQ TABLE (Frequently Asked Questions for Main SaaS Website)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS faq (
    id BIGSERIAL PRIMARY KEY,
    question TEXT NOT NULL,
    answer TEXT NOT NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_faq_updated_at ON faq;
CREATE TRIGGER update_faq_updated_at
    BEFORE UPDATE ON faq
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 21.1 UPDATES TABLE (SaaS Platform Product Releases, Changelog & Roadmap)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS updates (
    id BIGSERIAL PRIMARY KEY,
    version VARCHAR(50) NOT NULL,
    title VARCHAR(255) NOT NULL,
    slug VARCHAR(255) UNIQUE,
    description TEXT,
    changelog TEXT,
    release_date DATE DEFAULT CURRENT_DATE,
    is_published BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_updates_updated_at ON updates;
CREATE TRIGGER update_updates_updated_at
    BEFORE UPDATE ON updates
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 21.1b CREATOR UPDATES TABLE (In-Account Update Delivery & Read Tracking)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS creator_updates (
    id BIGSERIAL PRIMARY KEY,
    creator_id BIGINT NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    update_id BIGINT NOT NULL REFERENCES updates(id) ON DELETE CASCADE,
    is_read BOOLEAN DEFAULT FALSE,
    read_at TIMESTAMPTZ,
    emailed_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(creator_id, update_id)
);

-- ----------------------------------------------------------------------------
-- 21.2 TUTORIALS TABLE (Video Guides, Platform Walkthroughs & Documentation)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS tutorials (
    id BIGSERIAL PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    description TEXT,
    youtube_link VARCHAR(500) NOT NULL,
    is_published BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_tutorials_updated_at ON tutorials;
CREATE TRIGGER update_tutorials_updated_at
    BEFORE UPDATE ON tutorials
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 21.3. REPORTS TABLE (Platform Content Moderation & Abuse Reports)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS reports (
    id BIGSERIAL PRIMARY KEY,
    reporter_name VARCHAR(255) NOT NULL,
    reporter_email VARCHAR(255) NOT NULL,
    subject VARCHAR(255) NOT NULL,
    description TEXT NOT NULL,
    category VARCHAR(50) DEFAULT 'GENERAL',
    priority VARCHAR(50) DEFAULT 'MEDIUM',
    status VARCHAR(50) DEFAULT 'OPEN',
    admin_response TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_reports_updated_at ON reports;
CREATE TRIGGER update_reports_updated_at
    BEFORE UPDATE ON reports
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 22. SUPPORTS TABLE (Support Tickets & Helpdesk Sessions)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS supports (
    id BIGSERIAL PRIMARY KEY,
    creator_id BIGINT NOT NULL REFERENCES creators(id) ON DELETE CASCADE,
    website_id BIGINT REFERENCES websites(id) ON DELETE CASCADE,
    assigned_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    ticket_number VARCHAR(100) UNIQUE NOT NULL,
    subject VARCHAR(255) NOT NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'open' CHECK (status IN ('open', 'in_progress', 'waiting_for_user', 'resolved', 'closed')),
    priority VARCHAR(50) NOT NULL DEFAULT 'medium' CHECK (priority IN ('low', 'medium', 'high', 'urgent')),
    last_message_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_supports_updated_at ON supports;
CREATE TRIGGER update_supports_updated_at
    BEFORE UPDATE ON supports
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 23. SUPPORT MESSAGES TABLE (Individual Messages inside Support Chats)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS support_messages (
    id BIGSERIAL PRIMARY KEY,
    support_id BIGINT NOT NULL REFERENCES supports(id) ON DELETE CASCADE,
    sender_type VARCHAR(50) NOT NULL CHECK (sender_type IN ('creator', 'developer', 'system')),
    sender_id BIGINT NOT NULL,
    message TEXT,
    is_internal_note BOOLEAN DEFAULT FALSE,
    is_read BOOLEAN DEFAULT FALSE,
    read_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- ----------------------------------------------------------------------------
-- 24. SUPPORT IMAGES TABLE (Image Attachments for Support Messages)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS support_images (
    id BIGSERIAL PRIMARY KEY,
    message_id BIGINT NOT NULL REFERENCES support_messages(id) ON DELETE CASCADE,
    image_url TEXT NOT NULL,
    image_id VARCHAR(255),
    file_name VARCHAR(255),
    file_size INT,
    mime_type VARCHAR(100),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- ----------------------------------------------------------------------------
-- 25. LIVE CHATS TABLE (Real-time Live Chat Sessions for Visitors & Leads)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS live_chats (
    id BIGSERIAL PRIMARY KEY,
    session_id VARCHAR(255) UNIQUE NOT NULL,
    visitor_name VARCHAR(255) NOT NULL,
    visitor_email VARCHAR(255),
    visitor_phone VARCHAR(50),
    ip_address VARCHAR(100),
    user_agent TEXT,
    creator_id BIGINT REFERENCES creators(id) ON DELETE SET NULL,
    website_id BIGINT REFERENCES websites(id) ON DELETE CASCADE,
    assigned_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    status VARCHAR(50) DEFAULT 'OPEN',
    started_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    ended_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_live_chats_updated_at ON live_chats;
CREATE TRIGGER update_live_chats_updated_at
    BEFORE UPDATE ON live_chats
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- Alias view for singular queries (e.g., live_chat)
CREATE OR REPLACE VIEW live_chat AS SELECT * FROM live_chats;

-- ----------------------------------------------------------------------------
-- 26. LIVE CHAT MESSAGES TABLE (Real-time Live Chat Message Stream)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS live_chat_messages (
    id BIGSERIAL PRIMARY KEY,
    chat_id BIGINT NOT NULL REFERENCES live_chats(id) ON DELETE CASCADE,
    sender_type VARCHAR(50) DEFAULT 'VISITOR',
    sender_id BIGINT,
    sender_name VARCHAR(255) NOT NULL DEFAULT 'Visitor',
    message TEXT NOT NULL,
    attachment_url TEXT,
    is_read BOOLEAN DEFAULT FALSE,
    read_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- Alias view for singular queries (e.g., live_chat_message)
CREATE OR REPLACE VIEW live_chat_message AS SELECT * FROM live_chat_messages;

-- ----------------------------------------------------------------------------
-- 27. INTERNAL CHATS TABLE (Internal Staff & Developer 1-on-1 and Group Chats)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS internal_chats (
    id BIGSERIAL PRIMARY KEY,
    title VARCHAR(255),
    type VARCHAR(50) NOT NULL DEFAULT 'DIRECT' CHECK (type IN ('DIRECT', 'GROUP', 'direct', 'group')),
    created_by_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_internal_chats_updated_at ON internal_chats;
CREATE TRIGGER update_internal_chats_updated_at
    BEFORE UPDATE ON internal_chats
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 28. CHAT PARTICIPANTS TABLE (Staff Participants in Internal Chats)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS chat_participants (
    id BIGSERIAL PRIMARY KEY,
    chat_id BIGINT NOT NULL REFERENCES internal_chats(id) ON DELETE CASCADE,
    developer_id BIGINT NOT NULL REFERENCES developers(id) ON DELETE CASCADE,
    last_read_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (chat_id, developer_id)
);

-- ----------------------------------------------------------------------------
-- 29. CHAT MESSAGES TABLE (Staff Internal Messages)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS chat_messages (
    id BIGSERIAL PRIMARY KEY,
    chat_id BIGINT NOT NULL REFERENCES internal_chats(id) ON DELETE CASCADE,
    sender_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    message TEXT NOT NULL,
    is_system BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- ----------------------------------------------------------------------------
-- 30. CHAT IMAGES TABLE (Image Attachments for Internal Chat Messages)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS chat_images (
    id BIGSERIAL PRIMARY KEY,
    message_id BIGINT NOT NULL REFERENCES chat_messages(id) ON DELETE CASCADE,
    image_url TEXT NOT NULL,
    file_name VARCHAR(255),
    file_size INT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS developer_tasks (
    id BIGSERIAL PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    description TEXT,
    priority VARCHAR(50) DEFAULT 'medium',
    status VARCHAR(50) DEFAULT 'todo',
    developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    assigned_to_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    created_by_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    due_date TIMESTAMPTZ,
    completed_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS task_comments (
    id BIGSERIAL PRIMARY KEY,
    task_id BIGINT NOT NULL REFERENCES developer_tasks(id) ON DELETE CASCADE,
    developer_id BIGINT NOT NULL REFERENCES developers(id) ON DELETE CASCADE,
    comment TEXT NOT NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS notices (
    id BIGSERIAL PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    content TEXT NOT NULL,
    priority VARCHAR(50) DEFAULT 'NORMAL',
    category VARCHAR(100) DEFAULT 'GENERAL',
    is_pinned BOOLEAN DEFAULT FALSE,
    target_role VARCHAR(100) DEFAULT 'ALL',
    created_by_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    expires_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE OR REPLACE VIEW tasks AS 
SELECT id, title, description, priority, status, 
       developer_id, 
       COALESCE(assigned_to_developer_id, developer_id) AS assigned_to_developer_id,
       created_by_developer_id, due_date, completed_at, created_at, updated_at
FROM developer_tasks;


-- ============================================================================
-- SECTION 2: CORE PLATFORM PERFORMANCE INDEXES
-- ============================================================================

-- Core Platform Indexes
CREATE INDEX IF NOT EXISTS idx_websites_creator ON websites(creator_id);
CREATE INDEX IF NOT EXISTS idx_websites_subscription ON websites(subscription_id);
CREATE INDEX IF NOT EXISTS idx_websites_slug ON websites(slug);
CREATE INDEX IF NOT EXISTS idx_website_domains_site ON website_domains(website_id);
CREATE INDEX IF NOT EXISTS idx_website_domains_name ON website_domains(domain);
CREATE INDEX IF NOT EXISTS idx_website_information_site ON website_information(website_id);
CREATE INDEX IF NOT EXISTS idx_purchases_creator ON purchases(creator_id);
CREATE INDEX IF NOT EXISTS idx_purchases_website ON purchases(website_id);
CREATE INDEX IF NOT EXISTS idx_payments_purchase ON payments(purchase_id);
CREATE INDEX IF NOT EXISTS idx_wishlists_creator ON wishlists(creator_id);
CREATE INDEX IF NOT EXISTS idx_wishlists_package ON wishlists(package_id);
CREATE INDEX IF NOT EXISTS idx_subscriptions_creator ON subscriptions(creator_id);
CREATE INDEX IF NOT EXISTS idx_subscriptions_website ON subscriptions(website_id);
CREATE INDEX IF NOT EXISTS idx_subscriptions_package ON subscriptions(package_id);
CREATE INDEX IF NOT EXISTS idx_subscriptions_status ON subscriptions(status);
CREATE INDEX IF NOT EXISTS idx_supports_creator ON supports(creator_id);
CREATE INDEX IF NOT EXISTS idx_supports_website ON supports(website_id);
CREATE INDEX IF NOT EXISTS idx_support_messages_support ON support_messages(support_id);
CREATE INDEX IF NOT EXISTS idx_support_images_message ON support_images(message_id);
CREATE INDEX IF NOT EXISTS idx_blogs_slug ON blogs(slug);
CREATE INDEX IF NOT EXISTS idx_dev_login_activities_dev ON developer_login_activities(developer_id);
CREATE INDEX IF NOT EXISTS idx_dev_login_sessions_dev ON developer_login_sessions(developer_id);
CREATE INDEX IF NOT EXISTS idx_dev_login_sessions_token ON developer_login_sessions(token);
CREATE INDEX IF NOT EXISTS idx_creator_login_sessions_creator ON creator_login_sessions(creator_id);
CREATE INDEX IF NOT EXISTS idx_creator_login_sessions_token ON creator_login_sessions(token);
CREATE INDEX IF NOT EXISTS idx_creator_login_sessions_active ON creator_login_sessions(is_active);
CREATE INDEX IF NOT EXISTS idx_live_chats_session ON live_chats(session_id);
CREATE INDEX IF NOT EXISTS idx_live_chats_creator ON live_chats(creator_id);
CREATE INDEX IF NOT EXISTS idx_live_chats_developer ON live_chats(assigned_developer_id);
CREATE INDEX IF NOT EXISTS idx_live_chats_website ON live_chats(website_id);
CREATE INDEX IF NOT EXISTS idx_live_chats_status ON live_chats(status);
CREATE INDEX IF NOT EXISTS idx_live_chat_messages_chat ON live_chat_messages(chat_id);
CREATE INDEX IF NOT EXISTS idx_internal_chats_creator ON internal_chats(created_by_developer_id);
CREATE INDEX IF NOT EXISTS idx_chat_participants_chat ON chat_participants(chat_id);
CREATE INDEX IF NOT EXISTS idx_chat_participants_dev ON chat_participants(developer_id);
CREATE INDEX IF NOT EXISTS idx_chat_messages_chat ON chat_messages(chat_id);
CREATE INDEX IF NOT EXISTS idx_chat_messages_sender ON chat_messages(sender_developer_id);
CREATE INDEX IF NOT EXISTS idx_chat_images_message ON chat_images(message_id);
CREATE INDEX IF NOT EXISTS idx_creator_updates_creator ON creator_updates(creator_id);
CREATE INDEX IF NOT EXISTS idx_creator_updates_update ON creator_updates(update_id);
CREATE INDEX IF NOT EXISTS idx_email_logs_user_type ON email_logs(user_type, created_at DESC);

-- ----------------------------------------------------------------------------
-- 31. META CONVERSATIONS TABLE (Facebook, Instagram & WhatsApp Threads)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS meta_conversations (
    id BIGSERIAL PRIMARY KEY,
    platform VARCHAR(50) NOT NULL CHECK (platform IN ('facebook', 'instagram', 'whatsapp')),
    external_conversation_id VARCHAR(255) NOT NULL,
    recipient_id VARCHAR(255) NOT NULL,
    recipient_name VARCHAR(255) DEFAULT 'Customer',
    recipient_phone VARCHAR(50),
    recipient_avatar TEXT,
    last_message TEXT,
    last_message_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    status VARCHAR(50) NOT NULL DEFAULT 'OPEN' CHECK (status IN ('OPEN', 'RESOLVED', 'SPAM')),
    unread_count INT NOT NULL DEFAULT 0,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(platform, external_conversation_id)
);

DROP TRIGGER IF EXISTS update_meta_conversations_updated_at ON meta_conversations;
CREATE TRIGGER update_meta_conversations_updated_at
    BEFORE UPDATE ON meta_conversations
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

-- ----------------------------------------------------------------------------
-- 32. META MESSAGES TABLE (Facebook, Instagram & WhatsApp Messages & Replies)
-- ----------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS meta_messages (
    id BIGSERIAL PRIMARY KEY,
    conversation_id BIGINT NOT NULL REFERENCES meta_conversations(id) ON DELETE CASCADE,
    platform VARCHAR(50) NOT NULL CHECK (platform IN ('facebook', 'instagram', 'whatsapp')),
    sender_type VARCHAR(50) NOT NULL CHECK (sender_type IN ('CUSTOMER', 'STAFF', 'SYSTEM', 'customer', 'staff', 'system')),
    sender_id VARCHAR(255),
    sender_name VARCHAR(255),
    message_text TEXT NOT NULL,
    media_url TEXT,
    media_type VARCHAR(50),
    external_message_id VARCHAR(255),
    delivery_status VARCHAR(50) DEFAULT 'SENT' CHECK (delivery_status IN ('SENDING', 'SENT', 'DELIVERED', 'READ', 'FAILED', 'sending', 'sent', 'delivered', 'read', 'failed')),
    error_message TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- Platform alias views
CREATE OR REPLACE VIEW facebook_messages AS SELECT * FROM meta_messages WHERE platform = 'facebook';
CREATE OR REPLACE VIEW instagram_messages AS SELECT * FROM meta_messages WHERE platform = 'instagram';
CREATE OR REPLACE VIEW whatsapp_messages AS SELECT * FROM meta_messages WHERE platform = 'whatsapp';

-- Meta performance indexes
CREATE INDEX IF NOT EXISTS idx_meta_conversations_platform ON meta_conversations(platform);
CREATE INDEX IF NOT EXISTS idx_meta_conversations_status ON meta_conversations(status);
CREATE INDEX IF NOT EXISTS idx_meta_conversations_ext_id ON meta_conversations(external_conversation_id);
CREATE INDEX IF NOT EXISTS idx_meta_conversations_updated ON meta_conversations(updated_at DESC);
CREATE INDEX IF NOT EXISTS idx_meta_messages_conv ON meta_messages(conversation_id);
CREATE INDEX IF NOT EXISTS idx_meta_messages_platform ON meta_messages(platform);
CREATE INDEX IF NOT EXISTS idx_meta_messages_created ON meta_messages(created_at ASC);

CREATE TABLE IF NOT EXISTS leads (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL,
    phone VARCHAR(50),
    company VARCHAR(255),
    source VARCHAR(100) DEFAULT 'WEBSITE',
    status VARCHAR(50) DEFAULT 'NEW',
    notes TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_leads_email ON leads(email);
CREATE INDEX IF NOT EXISTS idx_leads_status ON leads(status);


CREATE TABLE IF NOT EXISTS payrolls (
    id BIGSERIAL PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    pay_period_start DATE NOT NULL,
    pay_period_end DATE NOT NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'DRAFT',
    total_amount NUMERIC(12, 2) NOT NULL DEFAULT 0.00,
    notes TEXT,
    created_by_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS developer_payrolls (
    id BIGSERIAL PRIMARY KEY,
    payroll_id BIGINT NOT NULL REFERENCES payrolls(id) ON DELETE CASCADE,
    developer_id BIGINT NOT NULL REFERENCES developers(id) ON DELETE CASCADE,
    base_salary NUMERIC(12, 2) NOT NULL DEFAULT 0.00,
    bonus NUMERIC(12, 2) NOT NULL DEFAULT 0.00,
    deductions NUMERIC(12, 2) NOT NULL DEFAULT 0.00,
    net_salary NUMERIC(12, 2) NOT NULL DEFAULT 0.00,
    payment_status VARCHAR(50) NOT NULL DEFAULT 'UNPAID',
    payment_method VARCHAR(50) DEFAULT 'BANK_TRANSFER',
    notes TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (payroll_id, developer_id)
);

CREATE TABLE IF NOT EXISTS payroll_payments (
    id BIGSERIAL PRIMARY KEY,
    developer_payroll_id BIGINT NOT NULL REFERENCES developer_payrolls(id) ON DELETE CASCADE,
    payroll_id BIGINT NOT NULL REFERENCES payrolls(id) ON DELETE CASCADE,
    developer_id BIGINT NOT NULL REFERENCES developers(id) ON DELETE CASCADE,
    amount NUMERIC(12, 2) NOT NULL DEFAULT 0.00,
    payment_method VARCHAR(50) NOT NULL DEFAULT 'BANK_TRANSFER',
    transaction_reference VARCHAR(255),
    payment_date TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    status VARCHAR(50) NOT NULL DEFAULT 'COMPLETED',
    processed_by_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    receipt_url TEXT,
    notes TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_payrolls_period ON payrolls(pay_period_start, pay_period_end);
CREATE INDEX IF NOT EXISTS idx_payrolls_status ON payrolls(status);
CREATE INDEX IF NOT EXISTS idx_payrolls_created_by ON payrolls(created_by_developer_id);
CREATE INDEX IF NOT EXISTS idx_dev_payrolls_payroll ON developer_payrolls(payroll_id);
CREATE INDEX IF NOT EXISTS idx_dev_payrolls_developer ON developer_payrolls(developer_id);
CREATE INDEX IF NOT EXISTS idx_dev_payrolls_status ON developer_payrolls(payment_status);
CREATE INDEX IF NOT EXISTS idx_payroll_payments_dp ON payroll_payments(developer_payroll_id);
CREATE INDEX IF NOT EXISTS idx_payroll_payments_payroll ON payroll_payments(payroll_id);
CREATE INDEX IF NOT EXISTS idx_payroll_payments_developer ON payroll_payments(developer_id);

CREATE TABLE IF NOT EXISTS platform_balances (
    id BIGSERIAL PRIMARY KEY,
    currency VARCHAR(10) NOT NULL DEFAULT 'BDT',
    total_revenue NUMERIC(15, 2) NOT NULL DEFAULT 0.00,
    available_balance NUMERIC(15, 2) NOT NULL DEFAULT 0.00,
    pending_balance NUMERIC(15, 2) NOT NULL DEFAULT 0.00,
    total_withdrawn NUMERIC(15, 2) NOT NULL DEFAULT 0.00,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_platform_balances_currency UNIQUE (currency)
);

DROP TRIGGER IF EXISTS update_platform_balances_updated_at ON platform_balances;
CREATE TRIGGER update_platform_balances_updated_at
    BEFORE UPDATE ON platform_balances
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

CREATE TABLE IF NOT EXISTS cashflows (
    id BIGSERIAL PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    category VARCHAR(100) NOT NULL DEFAULT 'subscription',
    flow_type VARCHAR(20) NOT NULL CHECK (flow_type IN ('inflow', 'outflow')),
    amount NUMERIC(15, 2) NOT NULL CHECK (amount >= 0.00),
    currency VARCHAR(10) NOT NULL DEFAULT 'BDT',
    balance_after NUMERIC(15, 2) NOT NULL DEFAULT 0.00,
    reference_type VARCHAR(50) NOT NULL,
    reference_id BIGINT,
    creator_id BIGINT REFERENCES creators(id) ON DELETE SET NULL,
    developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    payment_method VARCHAR(100) DEFAULT 'sslcommerz',
    metadata JSONB DEFAULT '{}'::jsonb,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_cashflows_flow_type ON cashflows(flow_type);
CREATE INDEX IF NOT EXISTS idx_cashflows_category ON cashflows(category);
CREATE INDEX IF NOT EXISTS idx_cashflows_creator ON cashflows(creator_id);
CREATE INDEX IF NOT EXISTS idx_cashflows_created_at ON cashflows(created_at DESC);

CREATE TABLE IF NOT EXISTS withdraws (
    id BIGSERIAL PRIMARY KEY,
    requested_by_id BIGINT REFERENCES developers(id) ON DELETE CASCADE,
    shareholder_id BIGINT REFERENCES shareholders(id) ON DELETE RESTRICT,
    withdraw_type VARCHAR(50) NOT NULL DEFAULT 'dividend' CHECK (withdraw_type IN ('developer_payout', 'dividend', 'capital_return', 'director_remuneration')),
    amount NUMERIC(15, 2) NOT NULL CHECK (amount > 0.00),
    currency VARCHAR(10) NOT NULL DEFAULT 'BDT',
    fee NUMERIC(15, 2) NOT NULL DEFAULT 0.00,
    net_amount NUMERIC(15, 2) NOT NULL DEFAULT 0.00,
    method VARCHAR(50) NOT NULL DEFAULT 'bank_transfer',
    account_details JSONB NOT NULL DEFAULT '{}'::jsonb,
    status VARCHAR(50) NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'approved', 'rejected', 'processed')),
    processed_by_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    notes TEXT,
    transaction_reference VARCHAR(150),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_withdraws_updated_at ON withdraws;
CREATE TRIGGER update_withdraws_updated_at
    BEFORE UPDATE ON withdraws
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

CREATE INDEX IF NOT EXISTS idx_withdraws_status ON withdraws(status);
CREATE INDEX IF NOT EXISTS idx_withdraws_requested_by ON withdraws(requested_by_id);
CREATE INDEX IF NOT EXISTS idx_withdraws_shareholder ON withdraws(shareholder_id);
CREATE INDEX IF NOT EXISTS idx_withdraws_created_at ON withdraws(created_at DESC);

CREATE TABLE IF NOT EXISTS shareholders (
    id BIGSERIAL PRIMARY KEY,
    shareholder_code VARCHAR(50) UNIQUE,
    name VARCHAR(255) NOT NULL,
    email VARCHAR(255) NOT NULL UNIQUE,
    phone VARCHAR(50),
    developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    role_title VARCHAR(150) NOT NULL DEFAULT 'Shareholder',
    shareholder_type VARCHAR(50) NOT NULL DEFAULT 'founder' CHECK (shareholder_type IN ('founder', 'individual', 'institutional', 'advisor', 'employee')),
    share_percentage NUMERIC(6, 3) NOT NULL DEFAULT 0.000 CHECK (share_percentage >= 0.000 AND share_percentage <= 100.000),
    total_shares BIGINT NOT NULL DEFAULT 0 CHECK (total_shares >= 0),
    payout_method VARCHAR(50) NOT NULL DEFAULT 'bank_transfer',
    account_details JSONB NOT NULL DEFAULT '{}'::jsonb,
    total_invested NUMERIC(15, 2) NOT NULL DEFAULT 0.00 CHECK (total_invested >= 0.00),
    total_withdrawn NUMERIC(15, 2) NOT NULL DEFAULT 0.00 CHECK (total_withdrawn >= 0.00),
    is_active BOOLEAN NOT NULL DEFAULT true,
    notes TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS update_shareholders_updated_at ON shareholders;
CREATE TRIGGER update_shareholders_updated_at
    BEFORE UPDATE ON shareholders
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

CREATE INDEX IF NOT EXISTS idx_shareholders_email ON shareholders(email);
CREATE INDEX IF NOT EXISTS idx_shareholders_active ON shareholders(is_active);
CREATE INDEX IF NOT EXISTS idx_shareholders_share_pct ON shareholders(share_percentage DESC);

CREATE TABLE IF NOT EXISTS share_classes (
    id BIGSERIAL PRIMARY KEY,
    class_name VARCHAR(100) NOT NULL,
    class_code VARCHAR(50) NOT NULL UNIQUE,
    par_value NUMERIC(12, 4) NOT NULL DEFAULT 1.0000 CHECK (par_value > 0),
    currency VARCHAR(10) NOT NULL DEFAULT 'BDT',
    voting_power_per_share NUMERIC(5, 2) NOT NULL DEFAULT 1.00 CHECK (voting_power_per_share >= 0),
    authorized_shares BIGINT NOT NULL DEFAULT 1000000 CHECK (authorized_shares > 0),
    issued_shares BIGINT NOT NULL DEFAULT 0 CHECK (issued_shares >= 0),
    is_dividend_bearing BOOLEAN NOT NULL DEFAULT true,
    liquidation_preference_multiple NUMERIC(5, 2) NOT NULL DEFAULT 1.00,
    notes TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_share_classes_code ON share_classes(class_code);

CREATE TABLE IF NOT EXISTS shares (
    id BIGSERIAL PRIMARY KEY,
    certificate_number VARCHAR(100) NOT NULL UNIQUE,
    shareholder_id BIGINT NOT NULL REFERENCES shareholders(id) ON DELETE RESTRICT,
    share_class_id BIGINT NOT NULL REFERENCES share_classes(id) ON DELETE RESTRICT,
    number_of_shares BIGINT NOT NULL CHECK (number_of_shares > 0),
    issue_price_per_share NUMERIC(15, 4) NOT NULL CHECK (issue_price_per_share >= 0),
    total_amount_paid NUMERIC(15, 2) NOT NULL CHECK (total_amount_paid >= 0),
    currency VARCHAR(10) NOT NULL DEFAULT 'BDT',
    issue_date DATE NOT NULL DEFAULT CURRENT_DATE,
    vesting_start_date DATE,
    vesting_months INT DEFAULT 0,
    cliff_months INT DEFAULT 0,
    status VARCHAR(50) NOT NULL DEFAULT 'issued' CHECK (status IN ('issued', 'vesting', 'transferred', 'cancelled', 'repurchased')),
    document_url TEXT,
    notes TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_shares_shareholder ON shares(shareholder_id);
CREATE INDEX IF NOT EXISTS idx_shares_class ON shares(share_class_id);
CREATE INDEX IF NOT EXISTS idx_shares_status ON shares(status);

CREATE TABLE IF NOT EXISTS investments (
    id BIGSERIAL PRIMARY KEY,
    round_name VARCHAR(100) NOT NULL,
    shareholder_id BIGINT NOT NULL REFERENCES shareholders(id) ON DELETE RESTRICT,
    share_class_id BIGINT REFERENCES share_classes(id) ON DELETE SET NULL,
    investment_amount NUMERIC(15, 2) NOT NULL CHECK (investment_amount > 0.00),
    currency VARCHAR(10) NOT NULL DEFAULT 'BDT',
    valuation_pre_money NUMERIC(15, 2) DEFAULT 0.00,
    valuation_post_money NUMERIC(15, 2) DEFAULT 0.00,
    shares_allocated BIGINT DEFAULT 0 CHECK (shares_allocated >= 0),
    share_percentage NUMERIC(6, 3) DEFAULT 0.000 CHECK (share_percentage >= 0.000 AND share_percentage <= 100.000),
    investment_date DATE NOT NULL DEFAULT CURRENT_DATE,
    payment_method VARCHAR(50) DEFAULT 'bank_transfer',
    payment_reference VARCHAR(150),
    cashflow_id BIGINT REFERENCES cashflows(id) ON DELETE SET NULL,
    agreement_url TEXT,
    is_dividend_reinvestment BOOLEAN NOT NULL DEFAULT false,
    status VARCHAR(50) NOT NULL DEFAULT 'completed' CHECK (status IN ('committed', 'received', 'completed', 'cancelled')),
    notes TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_investments_shareholder ON investments(shareholder_id);
CREATE INDEX IF NOT EXISTS idx_investments_date ON investments(investment_date DESC);
CREATE INDEX IF NOT EXISTS idx_investments_status ON investments(status);

CREATE TABLE IF NOT EXISTS share_transfers (
    id BIGSERIAL PRIMARY KEY,
    transfer_number VARCHAR(100) NOT NULL UNIQUE,
    from_shareholder_id BIGINT NOT NULL REFERENCES shareholders(id) ON DELETE RESTRICT,
    to_shareholder_id BIGINT NOT NULL REFERENCES shareholders(id) ON DELETE RESTRICT,
    share_class_id BIGINT NOT NULL REFERENCES share_classes(id) ON DELETE RESTRICT,
    shares_transferred BIGINT NOT NULL CHECK (shares_transferred > 0),
    percentage_transferred NUMERIC(6, 3) NOT NULL CHECK (percentage_transferred >= 0.000 AND percentage_transferred <= 100.000),
    transfer_price_per_share NUMERIC(15, 4) NOT NULL DEFAULT 0.0000,
    total_transfer_value NUMERIC(15, 2) NOT NULL DEFAULT 0.00,
    currency VARCHAR(10) NOT NULL DEFAULT 'BDT',
    transfer_date DATE NOT NULL DEFAULT CURRENT_DATE,
    transfer_type VARCHAR(50) NOT NULL DEFAULT 'secondary_sale' CHECK (transfer_type IN ('secondary_sale', 'founder_grant', 'gift', 'company_buyback', 'inheritance', 'esop_exercise')),
    board_resolution_reference VARCHAR(150),
    approved_by_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'completed' CHECK (status IN ('pending', 'approved', 'completed', 'rejected', 'cancelled')),
    deed_document_url TEXT,
    notes TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_share_transfers_from ON share_transfers(from_shareholder_id);
CREATE INDEX IF NOT EXISTS idx_share_transfers_to ON share_transfers(to_shareholder_id);
CREATE INDEX IF NOT EXISTS idx_share_transfers_status ON share_transfers(status);

CREATE TABLE IF NOT EXISTS dividend_declarations (
    id BIGSERIAL PRIMARY KEY,
    declaration_title VARCHAR(150) NOT NULL,
    financial_period VARCHAR(100) NOT NULL,
    total_declared_amount NUMERIC(15, 2) NOT NULL CHECK (total_declared_amount > 0.00),
    currency VARCHAR(10) NOT NULL DEFAULT 'BDT',
    net_profit_reference NUMERIC(15, 2) NOT NULL DEFAULT 0.00,
    distribution_percentage NUMERIC(5, 2) NOT NULL DEFAULT 100.00 CHECK (distribution_percentage >= 0.00 AND distribution_percentage <= 100.00),
    declared_by_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'declared' CHECK (status IN ('declared', 'approved', 'distributing', 'completed', 'cancelled')),
    declared_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    notes TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_dividend_declarations_period ON dividend_declarations(financial_period);

CREATE TABLE IF NOT EXISTS expenses (
    id BIGSERIAL PRIMARY KEY,
    expense_code VARCHAR(50) UNIQUE NOT NULL,
    title VARCHAR(255) NOT NULL,
    category VARCHAR(100) NOT NULL DEFAULT 'operational',
    amount NUMERIC(15, 2) NOT NULL DEFAULT 0.00 CHECK (amount >= 0.00),
    currency VARCHAR(10) NOT NULL DEFAULT 'BDT',
    expense_date DATE NOT NULL DEFAULT CURRENT_DATE,
    status VARCHAR(50) NOT NULL DEFAULT 'recorded' CHECK (status IN ('recorded', 'partially_paid', 'paid', 'cancelled')),
    payee_name VARCHAR(255) NOT NULL DEFAULT 'Vendor',
    payee_type VARCHAR(50) NOT NULL DEFAULT 'vendor' CHECK (payee_type IN ('developer', 'shareholder', 'vendor', 'contractor', 'government', 'external')),
    developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    payroll_payment_id BIGINT REFERENCES payroll_payments(id) ON DELETE SET NULL,
    created_by_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    receipt_url TEXT,
    notes TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_expenses_category ON expenses(category);
CREATE INDEX IF NOT EXISTS idx_expenses_date ON expenses(expense_date DESC);
CREATE INDEX IF NOT EXISTS idx_expenses_status ON expenses(status);
CREATE INDEX IF NOT EXISTS idx_expenses_payroll_payment ON expenses(payroll_payment_id);

DROP TRIGGER IF EXISTS update_expenses_updated_at ON expenses;
CREATE TRIGGER update_expenses_updated_at
    BEFORE UPDATE ON expenses
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

CREATE TABLE IF NOT EXISTS expense_transactions (
    id BIGSERIAL PRIMARY KEY,
    expense_id BIGINT NOT NULL REFERENCES expenses(id) ON DELETE CASCADE,
    transaction_number VARCHAR(100) NOT NULL UNIQUE,
    amount NUMERIC(15, 2) NOT NULL CHECK (amount > 0.00),
    currency VARCHAR(10) NOT NULL DEFAULT 'BDT',
    payment_method VARCHAR(50) NOT NULL DEFAULT 'bank_transfer',
    payment_reference VARCHAR(150),
    account_details JSONB DEFAULT '{}'::jsonb,
    paid_by_developer_id BIGINT REFERENCES developers(id) ON DELETE SET NULL,
    cashflow_id BIGINT REFERENCES cashflows(id) ON DELETE SET NULL,
    transaction_date TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    notes TEXT,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_expense_transactions_expense ON expense_transactions(expense_id);
CREATE INDEX IF NOT EXISTS idx_expense_transactions_date ON expense_transactions(transaction_date DESC);

